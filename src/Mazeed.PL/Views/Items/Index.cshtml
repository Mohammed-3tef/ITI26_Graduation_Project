@model IEnumerable<Mazeed.BLL.ViewModels.ItemVM>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Items";
}

@section Styles {
    <style>
        .nav-tabs-custom {
            border-bottom: 2px solid #e9ecef;
        }

        .nav-tabs-custom .nav-link {
            border: none;
            color: #6c757d;
            font-weight: 500;
            padding: 10px 30px;
            position: relative;
            background: transparent;
        }

        .nav-tabs-custom .nav-link.active {
            color: #dc3545;
            font-weight: 600;
            background: transparent;
        }

        .nav-tabs-custom .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: #dc3545;
        }

        .btn-action-view {
            background-color: #e3f2fd;
            color: #0d6efd;
            border: 1px solid #b6d4fe;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-action-view:hover {
            background-color: #0d6efd;
            color: #fff;
        }

        .btn-action-edit {
            background-color: #fff8dd;
            color: #ffc107;
            border: 1px solid #ffe69c;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-action-edit:hover {
            background-color: #ffc107;
            color: #fff;
        }

        .btn-action-delete {
            background-color: #ffe6e6;
            color: #dc3545;
            border: 1px solid #f5c2c7;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-action-delete:hover {
            background-color: #dc3545;
            color: #fff;
        }

        .item-icon-box {
            width: 45px;
            height: 45px;
            border-radius: 6px;
            background-color: #e3f2fd;
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
}

<!-- Navigation Tabs -->
<ul class="nav nav-tabs nav-tabs-custom justify-content-center mb-4" id="itemTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="view-tab" data-bs-toggle="tab" data-bs-target="#view-tab-pane" type="button" role="tab">
            View All Items
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="add-tab" data-bs-toggle="tab" data-bs-target="#add-tab-pane" type="button" role="tab">
            Add Item
        </button>
    </li>
</ul>

<div class="tab-content" id="itemTabsContent">
    <!-- View All Items Tab -->
    <div class="tab-pane fade show active" id="view-tab-pane" role="tabpanel" tabindex="0">
        <h4 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-box-open me-2 text-danger"></i>Items Management</h4>
        <div class="bg-white rounded-4 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-muted fw-bold">All Items</h5>
                <div class="input-group shadow-sm" style="width: 300px; border-radius: 20px; overflow: hidden;">
                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="itemSearchInput" class="form-control border-0 bg-light" placeholder="Search items...">
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 80px;">Icon</th>
                            <th scope="col" style="width: 80px;">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Price</th>
                            <th scope="col">Brand</th>
                            <th scope="col">Categories</th>
                            <th scope="col" class="text-center" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var catIdsJson = JsonSerializer.Serialize(item.CategoryIds ?? new List<long>());
                                var catNamesStr = string.Join(", ", item.CategoryNames ?? new List<string>());

                                <tr>
                                    <td>
                                        <div class="item-icon-box">
                                            <i class="fa-solid fa-box"></i>
                                        </div>
                                    </td>
                                    <td class="text-muted fw-semibold">#@item.Id</td>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td class="text-success fw-bold">@item.Price.ToString("F2") EGP</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="fa-solid fa-tag me-1 text-secondary"></i>@(item.BrandName ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.CategoryNames != null && item.CategoryNames.Any())
                                        {
                                            foreach (var cat in item.CategoryNames)
                                            {
                                                <span class="badge bg-secondary mb-1">@cat</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <!-- Details -->
                                            <button type="button"
                                                    class="btn btn-action-view btn-details"
                                                    title="View Details"
                                                    data-id="@item.Id"
                                                    data-name="@item.Name"
                                                    data-price="@item.Price"
                                                    data-brand="@(item.BrandName ?? "N/A")"
                                                    data-categories="@catNamesStr">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>

                                            <!-- Edit -->
                                            <button type="button"
                                                    class="btn btn-action-edit btn-edit"
                                                    title="Edit Item"
                                                    data-id="@item.Id"
                                                    data-name="@item.Name"
                                                    data-price="@item.Price"
                                                    data-brandid="@item.BrandId"
                                                    data-catids='@catIdsJson'>
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <!-- Delete -->
                                            <button type="button"
                                                    class="btn btn-action-delete btn-delete"
                                                    title="Delete Item"
                                                    data-id="@item.Id"
                                                    data-name="@item.Name">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-box-open fs-3 d-block mb-2"></i>
                                    No items found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add Item Tab -->
    <div class="tab-pane fade" id="add-tab-pane" role="tabpanel" tabindex="0">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6">
                <div class="bg-white rounded-4 shadow-sm p-4">
                    <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-plus-circle me-2"></i>Add New Item</h5>
                    <form asp-controller="Items" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Item Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Wireless Mouse" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Price</label>
                            <input type="number" step="0.01" name="Price" class="form-control" min="0" placeholder="0.00" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Brand</label>
                            <select name="BrandId" class="form-select" asp-items="ViewBag.BrandId" required>
                                <option value="">Select Brand</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Categories</label>
                            <select name="CategoryIds" class="form-select" asp-items="ViewBag.Categories" multiple required style="height: 120px;">
                            </select>
                            <small class="text-muted">Hold Ctrl / Cmd to select multiple categories.</small>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 rounded-pill">
                            <i class="fa-solid fa-plus me-1"></i> Save Item
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Details Item Modal -->
<div class="modal fade" id="detailsItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-circle-info me-2 text-primary"></i>Item Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="item-icon-box mx-auto fs-3" style="width: 70px; height: 70px; border-radius: 12px;">
                        <i class="fa-solid fa-box"></i>
                    </div>
                </div>
                <div class="list-group list-group-flush border-top border-bottom">
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Item ID:</span>
                        <span class="fw-bold" id="detailsItemId"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Item Name:</span>
                        <span class="fw-bold text-dark fs-5" id="detailsItemName"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Price:</span>
                        <span class="fw-bold text-success fs-5" id="detailsItemPrice"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Brand:</span>
                        <span class="fw-bold text-dark" id="detailsItemBrand"></span>
                    </div>
                    <div class="list-group-item py-3">
                        <span class="text-muted fw-semibold d-block mb-1">Categories:</span>
                        <span class="fw-bold text-dark" id="detailsItemCategories"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Item Modal -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen me-2"></i>Edit Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Items" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editItemId" name="Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item Name</label>
                        <input type="text" id="editItemName" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Price</label>
                        <input type="number" step="0.01" id="editItemPrice" min="0" name="Price" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Brand</label>
                        <select id="editItemBrandId" name="BrandId" class="form-select" asp-items="ViewBag.BrandId" required>
                            <option value="">Select Brand</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Categories</label>
                        <select id="editItemCategoryIds" name="CategoryIds" class="form-select" asp-items="ViewBag.Categories" multiple required style="height: 120px;">
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4">Update Item</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Item Modal -->
<div class="modal fade" id="deleteItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Items" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteItemId" name="id" />
                <div class="modal-body p-4 text-center">
                    <p class="mb-1 fs-5">Are you sure you want to delete item?</p>
                    <p class="fw-bold text-danger fs-5" id="deleteItemNameDisplay"></p>
                    <small class="text-muted">This action cannot be undone.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // Search Filter
            const searchInput = document.getElementById('itemSearchInput');
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    const filter = this.value.toLowerCase();
                    const rows = document.querySelectorAll('tbody tr');
                    
                    rows.forEach(row => {
                        // Skip if it's the "No items found" row
                        if (row.querySelector('td[colspan]')) return;
                        
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(filter) ? '' : 'none';
                    });
                });
            }

            // Details Modal Handler
            document.querySelectorAll('.btn-details').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');
                    const price = parseFloat(this.getAttribute('data-price')).toFixed(2);
                    const brand = this.getAttribute('data-brand');
                    const categories = this.getAttribute('data-categories');

                    document.getElementById('detailsItemId').textContent = '#' + id;
                    document.getElementById('detailsItemName').textContent = name;
                    document.getElementById('detailsItemPrice').textContent = price + ' EGP';
                    document.getElementById('detailsItemBrand').textContent = brand;
                    document.getElementById('detailsItemCategories').textContent = categories ? categories : '—';

                    const detailsModal = new bootstrap.Modal(document.getElementById('detailsItemModal'));
                    detailsModal.show();
                });
            });

            // Edit Modal Handler
            document.querySelectorAll('.btn-edit').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');
                    const price = this.getAttribute('data-price');
                    const brandId = this.getAttribute('data-brandid');
                    const catIds = JSON.parse(this.getAttribute('data-catids') || '[]');

                    document.getElementById('editItemId').value = id;
                    document.getElementById('editItemName').value = name;
                    document.getElementById('editItemPrice').value = price;
                    document.getElementById('editItemBrandId').value = brandId;

                    const categorySelect = document.getElementById('editItemCategoryIds');
                    Array.from(categorySelect.options).forEach(option => {
                        option.selected = catIds.map(String).includes(option.value);
                    });

                    const editModal = new bootstrap.Modal(document.getElementById('editItemModal'));
                    editModal.show();
                });
            });

            // Delete Modal Handler
            document.querySelectorAll('.btn-delete').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');

                    document.getElementById('deleteItemId').value = id;
                    document.getElementById('deleteItemNameDisplay').textContent = name;

                    const deleteModal = new bootstrap.Modal(document.getElementById('deleteItemModal'));
                    deleteModal.show();
                });
            });

        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}