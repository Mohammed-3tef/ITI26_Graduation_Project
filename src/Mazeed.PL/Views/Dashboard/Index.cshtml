@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sales Dashboard";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">

<style>
    .kpi-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        border: 1px solid #eef2f6;
    }

    .kpi-title {
        font-size: 13px;
        color: #6b7280;
        font-weight: 600;
        text-transform: uppercase;
    }

    .kpi-value {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
        margin-top: 5px;
    }

    .chart-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        border: 1px solid #eef2f6;
        height: 100%;
    }

    html[data-theme="dark"] .dashboard-page-card {
        background: var(--theme-surface) !important;
        border-color: var(--theme-border) !important;
    }
</style>

<div class="container-fluid py-4">
    <!-- 3 Slicers / Controls -->
    <div class="card dashboard-page-card p-3 mb-4 border-0 shadow-sm rounded-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold fs-7">Start Date</label>
                <input type="date" id="startDate" class="form-control form-control-sm" onchange="loadDashboardData()" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold fs-7">End Date</label>
                <input type="date" id="endDate" class="form-control form-control-sm" onchange="loadDashboardData()" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold fs-7">Categories</label>
                <select id="categoryFilter" class="form-select form-select-sm" onchange="loadDashboardData()">
                    <option value="">All categories</option>
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold fs-7">Brands</label>
                <select id="brandFilter" class="form-select form-select-sm" onchange="loadDashboardData()">
                    <option value="">All brands</option>
                    @foreach (var brand in ViewBag.Brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="kpi-title">Total Sales</div>
                <div class="kpi-value" id="kpiTotalSales">0.00 EGP</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="kpi-title">Total Orders</div>
                <div class="kpi-value" id="kpiTotalOrders">0</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="kpi-title">Avg Order Value</div>
                <div class="kpi-value" id="kpiAvgOrderValue">0.00 EGP</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="kpi-title">Active Shoppers</div>
                <div class="kpi-value" id="kpiActiveShoppers">0</div>
            </div>
        </div>
    </div>

    <!-- 5 Charts Grid -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-8">
            <div class="chart-card dashboard-page-card">
                <h6 class="fw-bold mb-3">Total Sales Trend</h6>
                <canvas id="salesTrendChart" height="120"></canvas>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="chart-card dashboard-page-card">
                <h6 class="fw-bold mb-3">Sales % by Category</h6>
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="chart-card dashboard-page-card">
                <h6 class="fw-bold mb-3">Payment Methods</h6>
                <canvas id="paymentChart"></canvas>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="chart-card dashboard-page-card">
                <h6 class="fw-bold mb-3">Top 8 Selling Items</h6>
                <canvas id="topItemsChart"></canvas>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="chart-card dashboard-page-card">
                <h6 class="fw-bold mb-3">Sales % by Order Status</h6>
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    let charts = {};

    document.addEventListener("DOMContentLoaded", function () {
        loadDashboardData();
    });

    document.addEventListener("mazeed-theme-changed", function () {
        if (Object.keys(charts).length > 0) loadDashboardData();
    });

    function loadDashboardData() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        const categories = Array.from(document.getElementById('categoryFilter').selectedOptions).map(o => o.value);
        const brands = Array.from(document.getElementById('brandFilter').selectedOptions).map(o => o.value);

        const params = new URLSearchParams({ startDate, endDate });
        categories.forEach(c => params.append('categoryIds', c));
        brands.forEach(b => params.append('brandIds', b));

        fetch(`/Dashboard/GetDashboardData?${params.toString()}`)
            .then(res => {
                if (!res.ok) throw new Error(`Dashboard request failed (${res.status})`);
                return res.json();
            })
            .then(data => {
                // Update KPIs
                document.getElementById('kpiTotalSales').innerText = `${data.kpis.totalSales.toLocaleString()} EGP`;
                document.getElementById('kpiTotalOrders').innerText = data.kpis.totalOrders.toLocaleString();
                document.getElementById('kpiAvgOrderValue').innerText = `${data.kpis.avgOrderValue.toFixed(2)} EGP`;
                document.getElementById('kpiActiveShoppers').innerText = data.kpis.activeShoppers.toLocaleString();

                // Render Charts
                renderChart('salesTrendChart', 'line', data.salesTrend.map(x => x.label), data.salesTrend.map(x => x.total), 'Sales Trend', '#ff4d4f');
                renderChart('categoryChart', 'doughnut', data.salesByCategory.map(x => x.label), data.salesByCategory.map(x => x.total), 'Category', ['#ff4d4f', '#111827', '#3b82f6', '#10b981']);
                renderChart('paymentChart', 'pie', data.paymentMethods.map(x => x.label), data.paymentMethods.map(x => x.count), 'Payments', ['#8b5cf6', '#f59e0b', '#ec4899']);
                renderChart('topItemsChart', 'bar', data.topItems.map(x => x.label), data.topItems.map(x => x.totalQuantity), 'Top Items', '#111827');
                renderChart('statusChart', 'doughnut', data.salesByStatus.map(x => x.label), data.salesByStatus.map(x => x.count), 'Status', ['#10b981', '#f59e0b', '#ef4444']);
            })
            .catch(error => {
                console.error('Unable to load dashboard data:', error);
            });
    }

    function renderChart(canvasId, type, labels, data, label, bgColors) {
        if (charts[canvasId]) charts[canvasId].destroy();
        const ctx = document.getElementById(canvasId).getContext('2d');
        const isDark = document.documentElement.dataset.theme === 'dark';
        charts[canvasId] = new Chart(ctx, {
            type: type,
            data: {
                labels: labels,
                datasets: [{
                    label: label,
                    data: data,
                    backgroundColor: bgColors,
                    borderColor: type === 'line' ? bgColors : '#ffffff',
                    tension: 0.3,
                    fill: false
                }]
            },
            options: {
                responsive: true,
                scales: type === 'line' || type === 'bar' ? {
                    x: { ticks: { color: isDark ? '#aab5c1' : '#6b7280' }, grid: { color: isDark ? '#354250' : '#e5e7eb' } },
                    y: { ticks: { color: isDark ? '#aab5c1' : '#6b7280' }, grid: { color: isDark ? '#354250' : '#e5e7eb' } }
                } : undefined,
                plugins: {
                    legend: { position: 'bottom', labels: { color: isDark ? '#aab5c1' : '#6b7280' } }
                }
            }
        });
    }
</script>