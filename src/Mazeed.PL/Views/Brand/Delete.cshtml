@model Mazeed.BLL.ViewModels.BrandVM

@{
    ViewData["Title"] = "Delete Brand";
}

<h2 class="text-danger">Delete Brand</h2>
<h3>Are you sure you want to delete this brand?</h3>
<hr />

<div class="card col-md-6 mb-3 border-danger">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Logo</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.Logo))
                {
                    <img src="@Model.Logo" alt="@Model.Name" class="img-fluid rounded" style="max-height: 100px;" />
                }
                else
                {
                    <span class="text-muted">No Logo</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>