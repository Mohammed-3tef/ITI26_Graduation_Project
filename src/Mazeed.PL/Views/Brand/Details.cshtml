@model Mazeed.BLL.ViewModels.BrandVM

@{
    ViewData["Title"] = "Brand Details";
}

<h2>Brand Details</h2>
<hr />

<div class="card col-md-6 mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Logo</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.Logo))
                {
                    <img src="@Model.Logo" alt="@Model.Name" class="img-fluid rounded" style="max-height: 120px;" />
                }
                else
                {
                    <span class="text-muted">No Logo provided</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>