@model IEnumerable<Mazeed.BLL.ViewModels.ItemVariantVM>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Item Variants";
}

@section Styles {
    <style>
        .nav-tabs-custom {
            border-bottom: 2px solid #e9ecef;
        }

        .nav-tabs-custom .nav-link {
            border: none;
            color: #6c757d;
            font-weight: 500;
            padding: 10px 30px;
            position: relative;
            background: transparent;
        }

        .nav-tabs-custom .nav-link.active {
            color: #dc3545;
            font-weight: 600;
            background: transparent;
        }

        .nav-tabs-custom .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: #dc3545;
        }

        .btn-action-view {
            background-color: #e3f2fd;
            color: #0d6efd;
            border: 1px solid #b6d4fe;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-action-view:hover {
            background-color: #0d6efd;
            color: #fff;
        }

        .btn-action-edit {
            background-color: #fff8dd;
            color: #ffc107;
            border: 1px solid #ffe69c;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-action-edit:hover {
            background-color: #ffc107;
            color: #fff;
        }

        .btn-action-delete {
            background-color: #ffe6e6;
            color: #dc3545;
            border: 1px solid #f5c2c7;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-action-delete:hover {
            background-color: #dc3545;
            color: #fff;
        }

        .variant-icon-box {
            width: 45px;
            height: 45px;
            border-radius: 6px;
            background-color: #e3f2fd;
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
}

<!-- Navigation Tabs -->
<ul class="nav nav-tabs nav-tabs-custom justify-content-center mb-4" id="variantTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="view-tab" data-bs-toggle="tab" data-bs-target="#view-tab-pane" type="button" role="tab">
            View All Variants
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="add-tab" data-bs-toggle="tab" data-bs-target="#add-tab-pane" type="button" role="tab">
            Add Variant
        </button>
    </li>
</ul>

<div class="tab-content" id="variantTabsContent">
    <!-- View All Variants Tab -->
    <div class="tab-pane fade show active" id="view-tab-pane" role="tabpanel" tabindex="0">
        <h4 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-layer-group me-2 text-danger"></i>Item Variants Management</h4>
        <div class="bg-white rounded-4 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 text-muted fw-bold">All Variants</h5>
                <div class="input-group shadow-sm" style="width: 300px; border-radius: 20px; overflow: hidden;">
                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="variantSearchInput" class="form-control border-0 bg-light" placeholder="Search variants...">
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">SKU</th>
                            <th scope="col">Item</th>
                            <th scope="col">Color</th>
                            <th scope="col">Size</th>
                            <th scope="col">Photos</th>
                            <th scope="col">Price Adj.</th>
                            <th scope="col">Stock</th>
                            <th scope="col" class="text-center" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@item.SKU</td>
                                    <td class="fw-semibold">@(item.ItemName ?? "N/A")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.Color</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Size</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@(item.Photos?.Count ?? 0)</span>
                                    </td>
                                    <td class="text-success fw-bold">+@item.PriceAdjustment.ToString("F2") EGP</td>
                                    <td>
                                        @if (item.StockQuantity <= item.LowStockThreshold)
                                        {
                                            <span class="badge bg-danger">@item.StockQuantity (Low)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@item.StockQuantity</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <!-- Details -->
                                            <button type="button"
                                                    class="btn btn-action-view"
                                                    title="View Details"
                                                    onclick='openDetailsVariantModal("@item.Id", @Html.Raw(JsonSerializer.Serialize(item.SKU)), @Html.Raw(JsonSerializer.Serialize(item.ItemName ?? "N/A")), @Html.Raw(JsonSerializer.Serialize(item.Color)), @Html.Raw(JsonSerializer.Serialize(item.Size)), "@item.PriceAdjustment", "@item.StockQuantity", "@item.LowStockThreshold", @Html.Raw(JsonSerializer.Serialize(item.Photos)))'>
                                                <i class="fa-solid fa-eye"></i>
                                            </button>

                                            <!-- Edit -->
                                            <button type="button"
                                                    class="btn btn-action-edit"
                                                    title="Edit Variant"
                                                    onclick='populateEditVariantModal("@item.Id", "@item.ItemId", @Html.Raw(JsonSerializer.Serialize(item.SKU)), @Html.Raw(JsonSerializer.Serialize(item.Color)), @Html.Raw(JsonSerializer.Serialize(item.Size)), "@item.PriceAdjustment", "@item.StockQuantity", "@item.LowStockThreshold", @Html.Raw(JsonSerializer.Serialize(item.Photos)))'>
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <!-- Delete -->
                                            <button type="button"
                                                    class="btn btn-action-delete"
                                                    title="Delete Variant"
                                                    onclick='openDeleteVariantModal("@item.Id", @Html.Raw(JsonSerializer.Serialize(item.SKU)))'>
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-cubes fs-3 d-block mb-2"></i>
                                    No item variants found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add Variant Tab -->
    <div class="tab-pane fade" id="add-tab-pane" role="tabpanel" tabindex="0">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6">
                <div class="bg-white rounded-4 shadow-sm p-4">
                    <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-plus-circle me-2"></i>Add New Item Variant</h5>
                    <form asp-controller="ItemVariants" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Item</label>
                            <select name="ItemId" class="form-select" asp-items="ViewBag.ItemId" required>
                                <option value="">Select Item</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">SKU</label>
                            <input type="text" name="SKU" class="form-control" placeholder="e.g. TSHIRT-BLK-L" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Color</label>
                                <input type="text" name="Color" class="form-control" placeholder="e.g. Black" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Size</label>
                                <input type="text" name="Size" class="form-control" placeholder="e.g. Large" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Price Adjustment</label>
                            <input type="number" step="0.01" name="PriceAdjustment" class="form-control" min="0" value="0.00" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Stock Quantity</label>
                                <input type="number" name="StockQuantity" class="form-control" min="0" value="0" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Low Stock Threshold</label>
                                <input type="number" name="LowStockThreshold" class="form-control" min="0" value="5" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Photo URLs (comma or newline separated)</label>
                            <textarea name="PhotoUrlsText" class="form-control" rows="3" placeholder="https://example.com/photo1.jpg&#10;https://example.com/photo2.jpg"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 rounded-pill mt-2">
                            <i class="fa-solid fa-plus me-1"></i> Save Variant
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Details Variant Modal -->
<div class="modal fade" id="detailsVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-circle-info me-2 text-primary"></i>Variant Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="variant-icon-box mx-auto fs-3" style="width: 70px; height: 70px; border-radius: 12px;">
                        <i class="fa-solid fa-cubes"></i>
                    </div>
                </div>
                <div class="list-group list-group-flush border-top border-bottom">
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">SKU:</span>
                        <span class="fw-bold text-dark fs-5" id="detailsVariantSKU"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Item:</span>
                        <span class="fw-bold text-dark" id="detailsVariantItem"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Color:</span>
                        <span class="fw-bold text-dark" id="detailsVariantColor"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Size:</span>
                        <span class="fw-bold text-dark" id="detailsVariantSize"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Price Adjustment:</span>
                        <span class="fw-bold text-success fs-5" id="detailsVariantPriceAdj"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Stock Quantity:</span>
                        <span class="fw-bold text-dark" id="detailsVariantStock"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted fw-semibold">Low Stock Threshold:</span>
                        <span class="fw-bold text-dark" id="detailsVariantThreshold"></span>
                    </div>
                    <div class="list-group-item d-flex flex-column py-3">
                        <span class="text-muted fw-semibold mb-2">Photos:</span>
                        <div id="detailsVariantPhotos" class="d-flex flex-wrap gap-2">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Variant Modal -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen me-2"></i>Edit Variant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="ItemVariants" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editVariantId" name="Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item</label>
                        <select id="editVariantItemId" name="ItemId" class="form-select" asp-items="ViewBag.ItemId" required>
                            <option value="">-- Select Item --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">SKU</label>
                        <input type="text" id="editVariantSKU" name="SKU" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Color</label>
                            <input type="text" id="editVariantColor" name="Color" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Size</label>
                            <input type="text" id="editVariantSize" name="Size" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Price Adjustment</label>
                        <input type="number" step="0.01" id="editVariantPriceAdj" name="PriceAdjustment" min="0" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Stock Quantity</label>
                            <input type="number" id="editVariantStock" name="StockQuantity" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Low Stock Threshold</label>
                            <input type="number" id="editVariantThreshold" name="LowStockThreshold" min="0" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Photo URLs (comma or newline separated)</label>
                        <textarea id="editVariantPhotoUrls" name="PhotoUrlsText" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4">Update Variant</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Variant Modal -->
<div class="modal fade" id="deleteVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="ItemVariants" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteVariantId" name="id" />
                <div class="modal-body p-4 text-center">
                    <p class="mb-1 fs-5">Are you sure you want to delete variant?</p>
                    <p class="fw-bold text-danger fs-5" id="deleteVariantSKUDisplay"></p>
                    <small class="text-muted">This action cannot be undone.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Search Filter
            const searchInput = document.getElementById('variantSearchInput');
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    const filter = this.value.toLowerCase();
                    const rows = document.querySelectorAll('tbody tr');
                    
                    rows.forEach(row => {
                        // Skip if it's the "No item variants found" row
                        if (row.querySelector('td[colspan]')) return;
                        
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(filter) ? '' : 'none';
                    });
                });
            }
        });

        function openDetailsVariantModal(id, sku, itemName, color, size, priceAdj, stock, threshold, photosJson) {
            document.getElementById('detailsVariantSKU').textContent = sku;
            document.getElementById('detailsVariantItem').textContent = itemName;
            document.getElementById('detailsVariantColor').textContent = color;
            document.getElementById('detailsVariantSize').textContent = size;
            document.getElementById('detailsVariantPriceAdj').textContent = '+' + parseFloat(priceAdj).toFixed(2) + ' EGP';
            document.getElementById('detailsVariantStock').textContent = stock;
            document.getElementById('detailsVariantThreshold').textContent = threshold;

            const photosContainer = document.getElementById('detailsVariantPhotos');
            photosContainer.innerHTML = '';
            if (photosJson && photosJson.length > 0) {
                photosJson.forEach(url => {
                    const img = document.createElement('img');
                    img.src = url;
                    img.className = 'rounded border';
                    img.style.width = '60px';
                    img.style.height = '60px';
                    img.style.objectFit = 'cover';
                    photosContainer.appendChild(img);
                });
            } else {
                photosContainer.innerHTML = '<span class="text-muted small">No photos</span>';
            }

            const detailsModal = new bootstrap.Modal(document.getElementById('detailsVariantModal'));
            detailsModal.show();
        }

        function populateEditVariantModal(id, itemId, sku, color, size, priceAdj, stock, threshold, photosJson) {
            document.getElementById('editVariantId').value = id;
            document.getElementById('editVariantItemId').value = itemId;
            document.getElementById('editVariantSKU').value = sku;
            document.getElementById('editVariantColor').value = color;
            document.getElementById('editVariantSize').value = size;
            document.getElementById('editVariantPriceAdj').value = priceAdj;
            document.getElementById('editVariantStock').value = stock;
            document.getElementById('editVariantThreshold').value = threshold;
            document.getElementById('editVariantPhotoUrls').value = (photosJson || []).join('\n');

            const editModal = new bootstrap.Modal(document.getElementById('editVariantModal'));
            editModal.show();
        }

        function openDeleteVariantModal(id, sku) {
            document.getElementById('deleteVariantId').value = id;
            document.getElementById('deleteVariantSKUDisplay').textContent = sku;

            const deleteModal = new bootstrap.Modal(document.getElementById('deleteVariantModal'));
            deleteModal.show();
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}