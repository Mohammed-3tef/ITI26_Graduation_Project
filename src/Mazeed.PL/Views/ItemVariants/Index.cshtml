@model IEnumerable<Mazeed.BLL.ViewModels.ItemVariantVM>

@{
    ViewData["Title"] = "Item Variants";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Item Variants</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Create New</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.SKU)</th>
                    <th>@Html.DisplayNameFor(model => model.Color)</th>
                    <th>@Html.DisplayNameFor(model => model.Size)</th>
                    <th>@Html.DisplayNameFor(model => model.PriceAdjustment)</th>
                    <th>@Html.DisplayNameFor(model => model.StockQuantity)</th>
                    <th>@Html.DisplayNameFor(model => model.ItemName)</th>
                    <th class="text-end me-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.SKU)</strong></td>
                        <td>@Html.DisplayFor(modelItem => item.Color)</td>
                        <td>@Html.DisplayFor(modelItem => item.Size)</td>
                        <td>$@Html.DisplayFor(modelItem => item.PriceAdjustment)</td>
                        <td>
                            @if (item.StockQuantity <= item.LowStockThreshold)
                            {
                                <span class="badge bg-danger">@item.StockQuantity (Low)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@item.StockQuantity</span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.ItemName)</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1"><i class="fa-solid fa-pen"></i> Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1"><i class="fa-solid fa-circle-info"></i> Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>