@model Mazeed.BLL.ViewModels.ItemVariantVM

@{
    ViewData["Title"] = "Create Item Variant";
}

<h2>Create Item Variant</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="ItemId" class="form-label fw-bold"></label>
                    <select asp-for="ItemId" class="form-select" asp-items="ViewBag.ItemId">
                        <option value="">-- Select Item --</option>
                    </select>
                    <span asp-validation-for="ItemId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SKU" class="form-label fw-bold"></label>
                    <input asp-for="SKU" class="form-control" placeholder="e.g. TSHIRT-BLK-L" />
                    <span asp-validation-for="SKU" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Color" class="form-label fw-bold"></label>
                        <input asp-for="Color" class="form-control" placeholder="e.g. Black" />
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Size" class="form-label fw-bold"></label>
                        <input asp-for="Size" class="form-control" placeholder="e.g. Large" />
                        <span asp-validation-for="Size" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PriceAdjustment" class="form-label fw-bold"></label>
                    <input asp-for="PriceAdjustment" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="PriceAdjustment" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockQuantity" class="form-label fw-bold"></label>
                        <input asp-for="StockQuantity" class="form-control" type="number" />
                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LowStockThreshold" class="form-label fw-bold"></label>
                        <input asp-for="LowStockThreshold" class="form-control" type="number" />
                        <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Create</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}