@model Mazeed.BLL.ViewModels.ItemVariantVM

@{
    ViewData["Title"] = "Delete Item Variant";
}

<h2 class="text-danger">Delete Item Variant</h2>
<h4 class="text-muted">Are you sure you want to delete this variant?</h4>
<hr />

<div class="card shadow-sm p-4 col-md-6 border-danger">
    <dl class="row mb-0">
        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.SKU)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.SKU)</dd>

        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.ItemName)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ItemName)</dd>

        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.Color)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Color)</dd>

        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.Size)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Size)</dd>

        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.StockQuantity)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.StockQuantity)</dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>