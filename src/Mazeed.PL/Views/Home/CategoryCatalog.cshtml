@model Mazeed.BLL.ViewModels.ShopCatalogVM

@{
    var currentCategoryName = Model?.Categories?.FirstOrDefault(c => c.Id == Model.CategoryId)?.Name
                             ?? (Model?.CategoryId.HasValue == true ? "Category" : "All Products");

    ViewData["Title"] = $"{currentCategoryName} Catalog";
}

<style>
    /* الفئات والمنتجات */
    .product-card {
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        overflow: hidden;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
    }

    .product-img-wrapper {
        position: relative;
        background-color: #f4f4f5;
        height: 210px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .badge-sale {
        position: absolute;
        top: 12px;
        left: 12px;
        background-color: #ff4d4f;
        color: white;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        z-index: 2;
    }

    .product-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }

    .category-tag {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #9ca3af;
        text-transform: uppercase;
    }

    .rating {
        font-size: 11px;
        font-weight: 700;
        color: #111827;
    }

    .product-title {
        font-size: 14px;
        font-weight: 700;
        color: #111827;
        margin-top: 4px;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .current-price {
        font-size: 15px;
        font-weight: 700;
        color: #ff4d4f;
    }

    .current-price.dark {
        color: #111827;
    }

    .original-price {
        font-size: 11px;
        color: #9ca3af;
        text-decoration: line-through;
        margin-left: 4px;
    }

    .wishlist-btn {
        background: none;
        border: none;
        color: #9ca3af;
        font-size: 22px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .wishlist-btn:hover {
        transform: scale(1.15);
    }

    .wishlist-btn.active {
        color: #ff4d4f;
    }

    .btn-action-dark {
        background-color: #111827;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 8px 0;
        font-size: 12px;
        font-weight: 600;
        width: 100%;
        text-align: center;
        text-decoration: none;
        display: block;
    }

    .btn-action-dark:hover {
        background-color: #1f2937;
        color: #ffffff;
    }

    .btn-action-light {
        background-color: #ffffff;
        color: #374151;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 8px 0;
        font-size: 12px;
        font-weight: 600;
        width: 100%;
        text-align: center;
        text-decoration: none;
        display: block;
    }

    .btn-action-light:hover {
        background-color: #f9fafb;
        color: #374151;
    }

    /* أزرار الترقيم Pagination */
    .pagination-dots-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 40px;
        margin-bottom: 20px;
    }

    .page-dot-btn {
        background: none;
        border: none;
        color: #d1d5db;
        font-size: 24px;
        cursor: pointer;
        padding: 0 4px;
        transition: color 0.2s ease;
    }

    .page-dot-btn:hover {
        color: #9ca3af;
    }

    .page-dot-btn.active {
        color: #111827;
    }

    .page-nav-btn {
        background-color: #111827;
        border: none;
        color: #ffffff;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

    .page-nav-btn:hover:not(:disabled) {
        background-color: #1f2937;
        transform: translateY(-1px);
    }

    .page-nav-btn:disabled {
        background-color: #e5e7eb;
        color: #9ca3af;
        cursor: not-allowed;
        transform: none;
    }

    .btn-filter-pill {
        border-radius: 50px;
        padding: 6px 18px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        color: #4b5563;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-filter-pill:hover {
        background-color: #111827;
        color: #ffffff;
        border-color: #111827;
    }
</style>

<div class="container-fluid px-0 my-4">

    <!-- Header & Filter Button -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <span class="text-uppercase fw-bold text-muted small tracking-wide">Category Catalog</span>
            <h1 class="fw-bold fs-2 text-dark mb-0">@currentCategoryName <span class="fs-5 text-muted fw-normal">(@(Model?.Items?.Count() ?? 0))</span></h1>
        </div>

        <button class="btn-filter-pill" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas">
            Filter & Sort <i class="fa-solid fa-sliders ms-1"></i>
        </button>
    </div>

    <!-- Product Grid الأصلي بدون أي تعديل في الـ Classes أو التقسيم -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3 g-md-4" id="productGrid">
        @if (Model?.Items != null && Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <div class="col product-item">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                            {
                                <span class="badge-sale">SALE</span>
                            }

                            @if (item.Photos != null && item.Photos.Any())
                            {
                                <img src="@item.Photos.First()" alt="@item.Name" />
                            }
                            else
                            {
                                <i class="fa-solid fa-box-open fa-3x text-muted"></i>
                            }
                        </div>
                        <div class="product-card-body">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="category-tag">@string.Join(", ", item.CategoryNames ?? new List<string>())</span>
                                    <span class="rating rating-value" data-item-id="@item.Id">&#9734; —</span>
                                </div>
                                <div class="product-title" title="@item.Name">@item.Name</div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="current-price @(item.OldPrice.HasValue && item.OldPrice > item.Price ? "" : "dark")">
                                            @item.Price.ToString("N0") EGP
                                        </span>
                                        @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                                        {
                                            <span class="original-price">@item.OldPrice.Value.ToString("N0") EGP</span>
                                        }
                                    </div>

                                    <button class="wishlist-btn" type="button" title="Add to Wishlist" data-item-id="@item.Id" onclick="toggleWishlist(this)">&#9825;</button>
                                </div>
                            </div>
                            <!-- تعديل تشغيل الأزرار Details و Cancel مع الحفاظ على التصميم -->
                            <div class="row g-2">
                                <div class="col-6">
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn-action-dark">Details</a>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn-action-light" onclick="hideProductCard(this)">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                <h5 class="text-muted fw-bold">No Products Available in @currentCategoryName</h5>
                <p class="text-muted small">Check back later for new arrivals in this section.</p>
            </div>
        }
    </div>

    <!-- Dynamic Pagination Controls -->
    <div class="pagination-dots-container" id="paginationContainer" style="display: none;">
        <button class="page-nav-btn" id="prevBtn" onclick="changePage(-1)" title="Previous">&#10094;</button>
        <div id="dotsWrapper" class="d-flex align-items-center gap-2"></div>
        <button class="page-nav-btn" id="nextBtn" onclick="changePage(1)" title="Next">&#10095;</button>
    </div>
</div>

<!-- Offcanvas Sidebar Filter & Sort -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel" style="width: 380px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold" id="filterOffcanvasLabel">Filter & Sort @currentCategoryName</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <form asp-controller="Home" asp-action="Category" method="get" class="d-flex flex-column h-100">
        <input type="hidden" name="id" value="@Model.CategoryId" />

        <div class="offcanvas-body">
            <div class="accordion accordion-flush" id="filterAccordion">

                <!-- Sort By -->
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingSort">
                        <button class="accordion-button collapsed fw-bold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSort">
                            Sort By
                        </button>
                    </h2>
                    <div id="collapseSort" class="accordion-collapse collapse show">
                        <div class="accordion-body">
                            <select name="sortBy" class="form-select">
                                <option value="">Default Order</option>
                                <option value="price_low_high" selected="@(Model.SortBy == "price_low_high")">Price: Low to High</option>
                                <option value="price_high_low" selected="@(Model.SortBy == "price_high_low")">Price: High to Low</option>
                                <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name: A to Z</option>
                                <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name: Z to A</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Price Range -->
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingPrice">
                        <button class="accordion-button collapsed fw-bold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrice">
                            Price Range
                        </button>
                    </h2>
                    <div id="collapsePrice" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="minPrice" class="form-control" placeholder="Min" value="@Model.MinPrice" />
                                </div>
                                <div class="col-6">
                                    <input type="number" name="maxPrice" class="form-control" placeholder="Max" value="@Model.MaxPrice" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="p-3 border-top bg-white">
            <button type="submit" class="btn btn-dark w-100 py-2 fw-bold text-uppercase">
                Apply Filters <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </div>
    </form>
</div>

<script>
    // الإبقاء على 16 عنصر في الصفحة كما كان أصلاً
    const itemsPerPage = 16;
    let currentPage = 0;

    function renderPagination() {
        const items = document.querySelectorAll('.product-item');
        const totalPages = Math.ceil(items.length / itemsPerPage);
        const container = document.getElementById('paginationContainer');
        const dotsWrapper = document.getElementById('dotsWrapper');

        if (items.length === 0) {
            container.style.display = 'none';
            return;
        }

        if (items.length <= itemsPerPage) {
            container.style.display = 'none';
            items.forEach(item => item.style.display = 'block');
            return;
        }

        container.style.display = 'flex';
        dotsWrapper.innerHTML = '';

        items.forEach((item, index) => {
            if (index >= currentPage * itemsPerPage && index < (currentPage + 1) * itemsPerPage) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });

        for (let i = 0; i < totalPages; i++) {
            const dot = document.createElement('button');
            dot.className = `page-dot-btn ${i === currentPage ? 'active' : ''}`;
            dot.innerHTML = '&bull;';
            dot.onclick = () => goToPage(i);
            dotsWrapper.appendChild(dot);
        }

        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        if (prevBtn) prevBtn.disabled = currentPage === 0;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
    }

    function goToPage(pageIndex) {
        currentPage = pageIndex;
        renderPagination();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function changePage(direction) {
        currentPage += direction;
        renderPagination();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function redirectToLogin() {
    const returnUrl = window.location.pathname + window.location.search;
    if (typeof toastr !== 'undefined') toastr.info('Please sign in to continue.');
    setTimeout(function () {
        window.location.href = '/Auth/Login?ReturnUrl=' + encodeURIComponent(returnUrl);
    }, 900);
    }

    function toggleWishlist(btn) {
        const itemId = btn.dataset.itemId;
        const isActive = btn.classList.contains('active');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers = { 'Accept': 'application/json' };
        if (token) headers['RequestVerificationToken'] = token;

        fetch(`/api/wishlist/${itemId}`, { method: isActive ? 'DELETE' : 'POST', headers })
            .then(res => {
                if (res.status === 401) {
                    redirectToLogin();
                    throw new Error('unauthenticated');
                }
                if (!res.ok) throw new Error('request failed');

                btn.classList.toggle('active');
                btn.innerHTML = btn.classList.contains('active') ? '&#9829;' : '&#9825;';
                if (typeof toastr !== 'undefined') {
                    toastr.success(isActive ? 'Removed from favorites.' : 'Added to favorites.');
                }
            })
            .catch(() => { /* handled or silent */ });
    }

    function prefillWishlistState() {
        fetch('/api/wishlist', { headers: { 'Accept': 'application/json' } })
            .then(res => res.ok ? res.json() : null)
            .then(result => {
                const favoritedIds = (result?.data || []).map(i => String(i.itemId));
                document.querySelectorAll('.wishlist-btn').forEach(btn => {
                    if (favoritedIds.includes(btn.dataset.itemId)) {
                        btn.classList.add('active');
                        btn.innerHTML = '&#9829;';
                    }
                });
            })
            .catch(() => { /* not signed in */ });
    }

    function loadRealRatings() {
        const ratingEls = document.querySelectorAll('.rating-value');
        const itemIds = Array.from(ratingEls).map(el => parseInt(el.dataset.itemId, 10));
        if (!itemIds.length) return;

        fetch('/api/reviews/summaries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ ItemIds: itemIds })
        })
            .then(res => res.ok ? res.json() : null)
            .then(result => {
                const summaries = result?.data || {};
                ratingEls.forEach(el => {
                    const s = summaries[el.dataset.itemId];
                    if (s && s.reviewCount > 0) {
                        el.innerHTML = `&#9733; ${s.averageRating.toFixed(1)} <span class="text-muted fw-normal">(${s.reviewCount})</span>`;
                    } else {
                        el.innerHTML = `&#9734; No reviews`;
                    }
                });
            })
            .catch(() => { /* leave placeholder dashes */ });
    }

    // دالة إخفاء الكارت عند الضغط على Cancel
    function hideProductCard(button) {
        const productItem = button.closest('.product-item');
        if (productItem) {
            productItem.remove();
            renderPagination();
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        renderPagination();
        prefillWishlistState();
        loadRealRatings();
    });
</script>