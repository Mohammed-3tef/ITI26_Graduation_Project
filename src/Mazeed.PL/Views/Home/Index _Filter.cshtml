<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-banner">
        <div class="col-12 col-md-10 col-lg-6">
            <span class="badge-pill-red mb-2 mb-md-3">Limited Time Drop</span>
            <h1 class="display-5 display-md-4 fw-bold text-white mb-2 mb-md-3">Seasonal Renewal</h1>
            <p class="text-white-50 mb-4 fs-6 leading-relaxed">
                Discover curated designs from international makers. Transform your routine with bespoke objects crafted for modern life.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <a asp-controller="Store" asp-action="Index" class="btn btn-light rounded-2 px-4 py-2 fw-semibold fs-7">Shop The Sale</a>
                <a asp-controller="Home" asp-action="About" class="text-white text-decoration-none fw-semibold fs-7">Learn More &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Section Header & Dynamic Category Filters -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end gap-3 mb-4">
        <div>
            <span class="badge-pill-red mb-1" style="background: none; color: #ff4d4f; padding: 0; font-size: 10px;">CURATED FINDS</span>
            <h2 class="fw-bold fs-3 text-dark mb-0">Featured Marketplace</h2>
        </div>
        <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-md-end">
            <div class="filter-scroll-container">
                <a asp-controller="Home" asp-action="Index" class="btn-filter @(Model?.SelectedCategoryIds == null || !Model.SelectedCategoryIds.Any() ? "active" : "")">All</a>
                @if (Model?.AvailableCategories != null && Model.AvailableCategories.Any())
                {
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <a asp-controller="Home" asp-action="Index" asp-route-SelectedCategoryIds="@cat.Id"
                           class="btn-filter @(Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Contains(cat.Id) ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                }
            </div>

            <button class="btn-filter border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas" style="cursor: pointer;">
                Filter <i class="fa-solid fa-sliders ms-1"></i>
            </button>
        </div>
    </div>

    <!-- Dynamic Product Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3 g-md-4" id="productGrid">
        @if (Model?.Items != null && Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-sm-6 col-lg-4 product-item" id="product-card-@item.Id">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                            {
                                <span class="badge-sale">SALE</span>
                            }

                            @if (item.Photos != null && item.Photos.Any())
                            {
                                <img src="@item.Photos.First()" alt="@item.Name" />
                            }
                            else
                            {
                                <i class="fa-solid fa-box-open fa-3x text-muted"></i>
                            }
                        </div>
                        <div class="product-card-body">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="category-tag">
                                        @(item.CategoryNames != null && item.CategoryNames.Any()
                                            ? item.CategoryNames.First()
                                            : (item.BrandName ?? "GENERAL"))
                                    </span>
                                    <span class="rating rating-value" data-item-id="@item.Id">&#9734; —</span>
                                </div>
                                <div class="product-title" title="@item.Name">@item.Name</div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="current-price @(item.OldPrice.HasValue && item.OldPrice > item.Price ? "" : "dark")">
                                            @item.Price.ToString("N2") EGP
                                        </span>
