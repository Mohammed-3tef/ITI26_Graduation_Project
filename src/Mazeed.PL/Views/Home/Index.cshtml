@model Mazeed.BLL.ViewModels.Search.FilterSortViewModel

@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-banner {
        background: linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.35)), url('https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
        border-radius: 16px;
        padding: 40px 20px;
        color: #ffffff;
        margin-bottom: 30px;
    }

    @@media (min-width: 768px) {
        .hero-banner {
            border-radius: 20px;
            padding: 90px 60px;
            margin-bottom: 40px;
        }
    }

    .badge-pill-red {
        background-color: #ff4d4f;
        color: white;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 4px;
        display: inline-block;
    }

    .badge-sale {
        position: absolute;
        top: 12px;
        left: 12px;
        background-color: #ff4d4f;
        color: white;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        z-index: 2;
    }

    .filter-scroll-container {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        white-space: nowrap;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }


    .btn-filter {
        border-radius: 50px;
        padding: 6px 18px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        color: #4b5563;
        text-decoration: none;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }


    .product-card {
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        overflow: hidden;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }


    .product-img-wrapper {
        position: relative;
        background-color: #f4f4f5;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    @@media (min-width: 576px) {
        .product-img-wrapper {
            height: 240px;
        }
    }

    .product-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }

    .category-tag {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #9ca3af;
        text-transform: uppercase;
    }

    .rating {
        font-size: 11px;
        font-weight: 700;
        color: #111827;
    }

    .product-title {
        font-size: 15px;
        font-weight: 700;
        color: #111827;
        margin-top: 4px;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .current-price {
        font-size: 16px;
        font-weight: 700;
        color: #ff4d4f;
    }


    .original-price {
        font-size: 12px;
        color: #9ca3af;
        text-decoration: line-through;
        margin-left: 4px;
    }

    .wishlist-btn {
        background: none;
        border: none;
        color: #9ca3af;
        font-size: 24px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.2s ease, transform 0.2s ease;
    }



    .btn-action-dark {
        background-color: #111827;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 8px 0;
        font-size: 12px;
        font-weight: 600;
        width: 100%;
        text-align: center;
        text-decoration: none;
        display: block;
    }

    }

    .pagination-dots-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 40px;
        margin-bottom: 20px;
    }

    .page-dot-btn {
        background: none;
        border: none;
        color: #d1d5db;
        font-size: 24px;
        cursor: pointer;
        padding: 0 4px;
        transition: color 0.2s ease;
    }



    .page-nav-btn {
        background-color: #111827;
        border: none;
        color: #ffffff;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

        .page-nav-btn:hover:not(:disabled) {
            background-color: #1f2937;
            transform: translateY(-1px);
        }
    .page-nav-btn:hover:not(:disabled) {
        background-color: #1f2937;
        transform: translateY(-1px);
    }

    .page-nav-btn:disabled {
        background-color: #e5e7eb;
        color: #9ca3af;
        cursor: not-allowed;
        transform: none;
    }

    .style-pointer { 
        cursor: pointer; 
        user-select: none; 
    }
    
    .toggle-icon { 
        font-size: 1.1rem; 
        font-weight: bold; 
    }
</style>
<style>
    /* تصفير وإعادة تصميم الـ Accordion بالكامل ليطابق الصورة الأولى */
.accordion-item {
    border: none !important;
    border-bottom: 1px solid #eaeaea !important;
    background: transparent !important;
}

.accordion-button {
    background: transparent !important;
    color: #222222 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    padding: 18px 0px !important;
    box-shadow: none !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    border: none;
    text-transform: capitalize;
}

/* إخفاء سهم Bootstrap الافتراضي تماماً */
.accordion-button::after {
    display: none !important;
}

/* إضافة علامة الزائد والناقص المخصصة الرفيعة */
.accordion-button::before {
    content: "+";
    order: 2;
    font-size: 1.25rem;
    font-weight: 300;
    color: #666;
    transition: transform 0.2s ease;
}

.accordion-button:not(.collapsed)::before {
    content: "−"; /* علامة الناقص الرفيعة */
}

.accordion-body {
    padding: 0px 0px 15px 0px !important;
}

/* تنسيق خطوط الأسعار والنصوص الفرعية الرمادية */
.filter-subtitle {
    font-size: 12px;
    color: #888888;
    margin-top: -10px;
    margin-bottom: 15px;
    display: block;
}

/* تحويل شريط السعر إلى اللون الأسود الرفيع تماماً مثل الصورة الأولى */
.form-range::-webkit-slider-thumb {
    background: #111111 !important;
    border: 2px solid #111111 !important;
    width: 14px;
    height: 14px;
}
.form-range::-moz-range-thumb {
    background: #111111 !important;
    border: 2px solid #111111 !important;
    width: 14px;
    height: 14px;
}
.form-range {
    height: 2px;
    background-color: #111111;
}

/* زر إزالة الفلاتر السفلي */
.btn-remove-filters {
    color: #222222 !important;
    font-size: 13px;
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
}


</style>

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-banner">
        <div class="col-12 col-md-10 col-lg-6">
            <span class="badge-pill-red mb-2 mb-md-3">Limited Time Drop</span>
            <h1 class="display-5 display-md-4 fw-bold text-white mb-2 mb-md-3">Seasonal Renewal</h1>
            <p class="text-white-50 mb-4 fs-6 leading-relaxed">
                Discover curated designs from international makers. Transform your routine with bespoke objects crafted for modern life.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <a asp-controller="Store" asp-action="Index" class="btn btn-light rounded-2 px-4 py-2 fw-semibold fs-7">Shop The Sale</a>
                <a asp-controller="Home" asp-action="About" class="text-white text-decoration-none fw-semibold fs-7">Learn More &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Section Header & Dynamic Category Filters -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end gap-3 mb-4">
        <div>
            <span class="badge-pill-red mb-1" style="background: none; color: #ff4d4f; padding: 0; font-size: 10px;">CURATED FINDS</span>
            <h2 class="fw-bold fs-3 text-dark mb-0">Featured Marketplace</h2>
        </div>
        <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-md-end">
            <div class="filter-scroll-container">
                <a asp-controller="Home" asp-action="Index" class="btn-filter @(Model?.SelectedCategoryIds == null || !Model.SelectedCategoryIds.Any() ? "active" : "")">All</a>
                @if (Model?.AvailableCategories != null && Model.AvailableCategories.Any())
                {
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <a asp-controller="Home" asp-action="Index" asp-route-SelectedCategoryIds="@cat.Id"
                           class="btn-filter @(Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Contains(cat.Id) ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                }
            </div>

            <button class="btn-filter border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas" style="cursor: pointer;">
                Filter <i class="fa-solid fa-sliders ms-1"></i>
            </button>
        </div>
    </div>

    <!-- Dynamic Product Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3 g-md-4" id="productGrid">
        @if (Model?.Items != null && Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-sm-6 col-lg-4 product-item" id="product-card-@item.Id">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                            {
                                <span class="badge-sale">SALE</span>
                            }

                            @if (item.Photos != null && item.Photos.Any())
                            {
                                <img src="@item.Photos.First()" alt="@item.Name" />
                            }
                            else
                            {
                                <i class="fa-solid fa-box-open fa-3x text-muted"></i>
                            }
                        </div>
                        <div class="product-card-body">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="category-tag">
                                        @(item.CategoryNames != null && item.CategoryNames.Any()
                                            ? item.CategoryNames.First()
                                            : (item.BrandName ?? "GENERAL"))
                                    </span>
                                    <span class="rating rating-value" data-item-id="@item.Id">&#9734; —</span>
                                </div>
                                <div class="product-title" title="@item.Name">@item.Name</div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="current-price @(item.OldPrice.HasValue && item.OldPrice > item.Price ? "" : "dark")">
                                            @item.Price.ToString("N2") EGP
                                        </span>
                                        @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                                        {
                                            <span class="original-price">@item.OldPrice.Value.ToString("N2") EGP</span>
                                        }
                                    </div>
                                    <button class="wishlist-btn" type="button" title="Add to Wishlist" data-item-id="@item.Id" onclick="toggleWishlist(this)">&#9825;</button>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12">
                                    <a asp-controller="Home"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn-action-dark text-center d-block text-decoration-none">Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                <h5 class="text-muted fw-bold">No products found</h5>
                <p class="text-muted small">Try selecting another category or check back later.</p>
            </div>
        }
    </div>

    <!-- Enhanced Offcanvas Filter Sidebar Component -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel" style="width: 380px;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold" id="filterOffcanvasLabel">Filter & Sort</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <form id="filterForm" asp-controller="Home" asp-action="Index" method="get" class="d-flex flex-column h-100">
            <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />

            <div class="offcanvas-body" style="overflow-y: auto;">
                <div class="accordion accordion-flush" id="filterAccordion">

                    <!-- 1. Sort Section -->
                    <div class="accordion-item border-bottom py-1">
                        <h2 class="accordion-header" id="headingSort">
                            <button class="accordion-button collapsed fw-bold text-uppercase ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSort">
                                Sort By
                            </button>
                        </h2>
                        <div id="collapseSort" class="accordion-collapse collapse show">
                            <div class="accordion-body ps-0">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="SelectedSort" id="sortRec" value="recommended" @(Model.SelectedSort == "recommended" || string.IsNullOrEmpty(Model.SelectedSort) ? "checked" : "")>
                                    <label class="form-check-label ms-1" for="sortRec">Recommended Sorting</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="SelectedSort" id="sortLow" value="lowToHigh" @(Model.SelectedSort == "lowToHigh" ? "checked" : "")>
                                    <label class="form-check-label ms-1" for="sortLow">Price: Low to High</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="SelectedSort" id="sortHigh" value="highToLow" @(Model.SelectedSort == "highToLow" ? "checked" : "")>
                                    <label class="form-check-label ms-1" for="sortHigh">Price: High to Low</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Product Category Section -->
                    <div class="accordion-item border-bottom py-1">
                        <h2 class="accordion-header" id="headingCategory">
                            <button class="accordion-button collapsed fw-bold text-uppercase ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCategory">
                                Product Category
                            </button>
                        </h2>
                        <div id="collapseCategory" class="accordion-collapse collapse">
                            <div class="accordion-body ps-0" id="categorySection">
                                @if (Model.AvailableCategories != null && Model.AvailableCategories.Any())
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="allCategories" />
                                        <label class="form-check-label fw-bold ms-1" for="allCategories">Select All</label>
                                    </div>
                                    @foreach (var category in Model.AvailableCategories)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input cat-checkbox" type="checkbox" name="SelectedCategoryIds" id="cat_@category.Id" value="@category.Id" @(Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Contains(category.Id) ? "checked" : "") />
                                            <label class="form-check-label ms-1" for="cat_@category.Id">@category.Name</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 3. Brand Section -->
                    <div class="accordion-item border-bottom py-1">
                        <h2 class="accordion-header" id="headingBrand">
                            <button class="accordion-button collapsed fw-bold text-uppercase ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBrand">
                                Brand
                            </button>
                        </h2>
                        <div id="collapseBrand" class="accordion-collapse collapse">
                            <div class="accordion-body ps-0" id="brandSection">
                                @if (Model.AvailableBrands != null && Model.AvailableBrands.Any())
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="allBrands" />
                                        <label class="form-check-label fw-bold ms-1" for="allBrands">Select All</label>
                                    </div>
                                    @foreach (var brand in Model.AvailableBrands)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input brand-checkbox" type="checkbox" name="SelectedBrandIds" id="brand_@brand.Id" value="@brand.Id" @(Model.SelectedBrandIds != null && Model.SelectedBrandIds.Contains(brand.Id) ? "checked" : "") />
                                            <label class="form-check-label ms-1" for="brand_@brand.Id">@brand.Name</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 4. Size Section -->
                    <div class="accordion-item border-bottom py-1">
                        <h2 class="accordion-header" id="headingSize">
                            <button class="accordion-button collapsed fw-bold text-uppercase ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSize">
                                Size
                            </button>
                        </h2>
                        <div id="collapseSize" class="accordion-collapse collapse">
                            <div class="accordion-body ps-0" id="sizeSection">
                                @if (Model.AvailableSizes != null)
                                {
                                    @foreach (var size in Model.AvailableSizes)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="SelectedSizes" value="@size" id="size_@size" @(Model.SelectedSizes != null && Model.SelectedSizes.Contains(size) ? "checked" : "")>
                                            <label class="form-check-label ms-1" for="size_@size">@size</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 5. Color Section -->
                    <div class="accordion-item border-bottom py-1">
                        <h2 class="accordion-header" id="headingColor">
                            <button class="accordion-button collapsed fw-bold text-uppercase ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseColor">
                                Color
                            </button>
                        </h2>
                        <div id="collapseColor" class="accordion-collapse collapse">
                            <div class="accordion-body ps-0" id="colorSection">
                                @if (Model.AvailableColors != null)
                                {
                                    @foreach (var color in Model.AvailableColors)
                                    {
                                        <div class="form-check d-flex align-items-center mb-2">
                                            <input class="form-check-input me-2" type="checkbox" name="SelectedColors" value="@color.Name" id="color_@color.Name" @(Model.SelectedColors != null && Model.SelectedColors.Contains(color.Name) ? "checked" : "")>
                                            <span class="color-preview me-2" style="background: @color.HexCode; width: 18px; height: 18px; display: inline-block; border: 1px solid #ccc; border-radius: 2px;"></span>
                                            <label class="form-check-label" for="color_@color.Name">@color.Name</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    

                    <!-- 6. Price Range Slider Section -->
                    <div class="accordion-item border-bottom py-1">
                        <h2 class="accordion-header" id="headingPrice">
                            <button class="accordion-button collapsed fw-bold text-uppercase ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrice">
                                Price
                            </button>
                        </h2>
                        <div id="collapsePrice" class="accordion-collapse collapse">
                            <div class="accordion-body ps-0 px-2">
                                <div class="d-flex justify-content-between text-muted small mb-2">
                                    <span><span id="minPriceVal">@(Model.MinPrice ?? 0)</span> EGP</span>
                                    <span><span id="maxPriceVal">@(Model.MaxPrice ?? 100000000)</span> EGP</span>
                                </div>
                                <input type="range" class="form-range" name="MinPrice" min="0" max="100000000" step="50" value="@(Model.MinPrice ?? 199)" id="minPriceSlider">
                                <input type="range" class="form-range mt-1" name="MaxPrice" min="0" max="100000000" step="50" value="@(Model.MaxPrice ?? 3499)" id="maxPriceSlider">
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Bottom Control Frame inside Offcanvas -->
            <div class="p-3 border-top bg-white">
                <button type="submit" class="btn btn-dark w-100 py-2.5 fw-bold text-uppercase mb-2">
                    Apply (@Model.TotalCount) <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
                <div class="text-center">
                    <a href="@Url.Action("Index", "Home")" class="text-muted small text-decoration-underline">Remove Filters</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Pagination Controls -->
    @if (Model?.Items != null && Model.Items.Count() > 9)
    {
        <div class="pagination-dots-container" id="paginationContainer">
            <button class="page-nav-btn" id="prevBtn" onclick="changePage(-1)" title="Previous">&#10094;</button>
            <button class="page-dot-btn active" onclick="goToPage(0)">&bull;</button>
            <button class="page-dot-btn" onclick="goToPage(1)">&bull;</button>
            <button class="page-dot-btn" onclick="goToPage(2)">&bull;</button>
            <button class="page-nav-btn" id="nextBtn" onclick="changePage(1)" title="Next">&#10095;</button>
        </div>
    }
</div>

@section Scripts {
    <!-- Inject current dataset variables directly into the browser DOM frame environment safely -->
    <script>
        window.CatalogItemsContext = @Html.Raw(Json.Serialize(Model.Items.Select(i => new
            {
                    id = i.Id,
                    brandId = i.BrandId,
                    categoryIds = i.CategoryIds,
                    variants = i.Variants?.Select(v => new { color = v.Color, size = v.Size })
            })));
    </script>

    <script>
        const itemsPerPage = 9;
        let currentPage = 0;

        function renderPagination() {
            const items = document.querySelectorAll('.product-item');
            const totalPages = Math.ceil(items.length / itemsPerPage);

            items.forEach((item, index) => {
                if (index >= currentPage * itemsPerPage && index < (currentPage + 1) * itemsPerPage) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });

            const dots = document.querySelectorAll('.page-dot-btn');
            dots.forEach((dot, index) => {
                if (index < totalPages) {
                    dot.style.display = 'inline-block';
                    dot.classList.toggle('active', index === currentPage);
                } else {
                    dot.style.display = 'none';
                }
            });

            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            if (prevBtn) prevBtn.disabled = currentPage === 0;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
        }

        function goToPage(pageIndex) {
            currentPage = pageIndex;
            renderPagination();
        }

        function changePage(direction) {
            currentPage += direction;
            renderPagination();
        }

        function redirectToLogin() {
            const returnUrl = window.location.pathname + window.location.search;
            if (typeof toastr !== 'undefined') toastr.info('Please sign in to continue.');
            setTimeout(function () {
                window.location.href = '/Auth/Login?ReturnUrl=' + encodeURIComponent(returnUrl);
            }, 900);
        }

        function toggleWishlist(btn) {
            const itemId = btn.dataset.itemId;
            const isActive = btn.classList.contains('active');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const headers = { 'Accept': 'application/json' };
            if (token) headers['RequestVerificationToken'] = token;

            fetch(`/api/wishlist/${itemId}`, { method: isActive ? 'DELETE' : 'POST', headers })
                .then(res => {
                    if (res.status === 401) {
                        redirectToLogin();
                        throw new Error('unauthenticated');
                    }
                    if (!res.ok) throw new Error('request failed');

                    btn.classList.toggle('active');
                    btn.innerHTML = btn.classList.contains('active') ? '&#9829;' : '&#9825;';
                    if (typeof toastr !== 'undefined') {
                        toastr.success(isActive ? 'Removed from favorites.' : 'Added to favorites.');
                    }
                })
                .catch(() => { /* handled or silent */ });
        }

        function prefillWishlistState() {
            fetch('/api/wishlist', { headers: { 'Accept': 'application/json' } })
                .then(res => res.ok ? res.json() : null)
                .then(result => {
                    const favoritedIds = (result?.data || []).map(i => String(i.itemId));
                    document.querySelectorAll('.wishlist-btn').forEach(btn => {
                        if (favoritedIds.includes(btn.dataset.itemId)) {
                            btn.classList.add('active');
                            btn.innerHTML = '&#9829;';
                        }
                    });
                })
                .catch(() => { /* not signed in */ });
        }

        function loadRealRatings() {
            const ratingEls = document.querySelectorAll('.rating-value');
            const itemIds = Array.from(ratingEls).map(el => parseInt(el.dataset.itemId, 10));
            if (!itemIds.length) return;

            fetch('/api/reviews/summaries', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ ItemIds: itemIds })
            })
                .then(res => res.ok ? res.json() : null)
                .then(result => {
                    const summaries = result?.data || {};
                    ratingEls.forEach(el => {
                        const s = summaries[el.dataset.itemId];
                        if (s && s.reviewCount > 0) {
                            el.innerHTML = `&#9733; ${s.averageRating.toFixed(1)}`;
                        } else {
                            el.innerHTML = `&#9734; New`;
                        }
                    });
                })
                .catch(() => { /* leave placeholder dashes */ });
        }

        function hideProductCard(productId) {
            const cardElement = document.getElementById('product-card-' + productId);
            if (cardElement) {
                cardElement.style.transition = "all 0.4s ease";
                cardElement.style.opacity = "0";
                cardElement.style.transform = "scale(0.9)";
                setTimeout(() => {
                    cardElement.remove();
                    renderPagination();
                }, 400);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const filterForm = document.getElementById('filterForm');
            if (!filterForm) return;

            renderPagination();
            prefillWishlistState();
            loadRealRatings();

            // 1. Dual Slider constraint management handles
            const minSlider = document.getElementById('minPriceSlider');
            const maxSlider = document.getElementById('maxPriceSlider');
            const minPriceVal = document.getElementById('minPriceVal');
            const maxPriceVal = document.getElementById('maxPriceVal');

            function handlePriceChange() {
                let minVal = parseInt(minSlider.value);
                let maxVal = parseInt(maxSlider.value);

                if (minVal > maxVal) {
                    minSlider.value = maxVal;
                    minVal = maxVal;
                }
                
                minPriceVal.textContent = minVal;
                maxPriceVal.textContent = maxVal;
            }

            if (minSlider && maxSlider) {
                minSlider.addEventListener('input', handlePriceChange);
                maxSlider.addEventListener('input', handlePriceChange);
            }

            // 2. Select All Master/Child checkbox handlers
            function setupSelectAll(masterId, childClass) {
                const master = document.getElementById(masterId);
                if (!master) return;

                master.addEventListener('change', function() {
                    document.querySelectorAll('.' + childClass).forEach(cb => cb.checked = this.checked);
                });

                document.querySelectorAll('.' + childClass).forEach(cb => {
                    cb.addEventListener('change', function() {
                        const all = document.querySelectorAll('.' + childClass);
                        const checked = document.querySelectorAll('.' + childClass + ':checked');
                        master.checked = (all.length === checked.length);
                        master.indeterminate = (checked.length > 0 && checked.length < all.length);
                    });
                });
            }

            setupSelectAll('allCategories', 'cat-checkbox');
            setupSelectAll('allBrands', 'brand-checkbox');

            // 3. Automatic Submit on Input Intercept
            // const filterForm = document.getElementById('filterForm');
            // if (filterForm) {
            //     filterForm.querySelectorAll('input[type="checkbox"], input[type="radio"]').forEach(input => {
            //         input.addEventListener('change', function () {
            //             if (this.id === 'allCategories' || this.id === 'allBrands') {
            //                 setTimeout(() => filterForm.submit(), 50);
            //             } else {
            //                 filterForm.submit();
            //             }
            //         });
            //     });

            //     if (minSlider && maxSlider) {
            //         minSlider.addEventListener('change', () => filterForm.submit());
            //         maxSlider.addEventListener('change', () => filterForm.submit());
            //     }
            // }

            // 4. Auto-Open Sidebar on Page Reload if filters are actively set
            // const urlParams = new URLSearchParams(window.location.search);
            // const hasActiveFilters = urlParams.has('SelectedCategoryIds') || 
            //                          urlParams.has('SelectedBrandIds') || 
            //                          urlParams.has('SelectedColors') || 
            //                          urlParams.has('SelectedSizes') || 
            //                          urlParams.has('SelectedSort') ||
            //                          urlParams.has('MinPrice') || 
            //                          urlParams.has('MaxPrice');

            // if (hasActiveFilters) {
            //     const filterSidebarEl = document.getElementById('filterOffcanvas');
            //     if (filterSidebarEl) {
            //         const bsOffcanvas = new bootstrap.Offcanvas(filterSidebarEl);
            //         bsOffcanvas.show();
            //     }
            // }

            // Helper function to dynamically filter colors and brands based on selected categories via DOM metadata attributes
            function updateDependantFilters() {
                // 1. Get all currently checked Category IDs
                const checkedCategoryIds = Array.from(document.querySelectorAll('.cat-checkbox:checked')).map(cb => cb.value);

                // 2. Fetch the catalog data model embedded as JSON data nodes from the page layout frame
                const items = window.CatalogItemsContext || [];

                // If no categories are explicitly selected, make all brands and colors available by default
                if (checkedCategoryIds.length === 0) {
                    document.querySelectorAll('#colorSection .form-check, #brandSection .form-check').forEach(el => {
                        el.style.display = 'block';
                    });
                    document.querySelectorAll('#sizeSection .form-check, #brandSection .form-check').forEach(el => {
                        el.style.display = 'block';
                    });
                    return;
                }

                // 3. Extract matching brands and colors from our local JSON array copy that belong to the active categories
                const allowedBrandIds = new Set();
                const allowedColorNames = new Set();
                const allowedSizeNames = new Set();

                items.forEach(item => {
                    // Check if the item belongs to any of the checked category IDs
                    const matchesCategory = item.categoryIds && item.categoryIds.some(catId => checkedCategoryIds.includes(String(catId)));

                    if (matchesCategory) {
                        if (item.brandId) allowedBrandIds.add(String(item.brandId));
                        if (item.variants) {
                            item.variants.forEach(v => {
                                if (v.color) allowedColorNames.add(v.color.trim().toLowerCase());
                                if (v.size) allowedSizeNames.add(v.size.trim().toLowerCase());
                            });
                        }
                    }
                });

                // 4. Update the Brand checkboxes UI layer visibility
                document.querySelectorAll('#brandSection .brand-checkbox').forEach(cb => {
                    const container = cb.closest('.form-check');
                    if (cb.id === 'allBrands') return; // Skip master check toggle button frame

                    if (allowedBrandIds.has(cb.value)) {
                        container.style.display = 'block';
                    } else {
                        container.style.display = 'none';
                        cb.checked = false; // Automatically uncheck hidden items to keep form data accurate
                    }
                });

                // 5. Update the Color checkboxes UI layer visibility
                document.querySelectorAll('#colorSection input[name="SelectedColors"]').forEach(cb => {
                    const container = cb.closest('.form-check');
                    const colorValue = cb.value.trim().toLowerCase();

                    if (allowedColorNames.has(colorValue)) {
                        container.style.display = 'flex'; // Use flex to match alignment layout rules safely
                    } else {
                        container.style.display = 'none';
                        cb.checked = false; // Automatically uncheck hidden colors
                    }
                });

                // 6. Update the Size checkboxes UI layer visibility
                document.querySelectorAll('#sizeSection input[name="SelectedSizes"]').forEach(cb => {
                    const container = cb.closest('.form-check');
                    const sizeValue = cb.value.trim().toLowerCase();

                    if (allowedSizeNames.has(sizeValue)) {
                        container.style.display = 'flex'; // Use flex to match alignment layout rules safely
                    } else {
                        container.style.display = 'none';
                        cb.checked = false; // Automatically uncheck hidden Size
                    }
                });
            }

            // Bind event listeners to all category choices to run our dynamic UI filtering function
            document.querySelectorAll('.cat-checkbox').forEach(cb => {
                cb.addEventListener('change', updateDependantFilters);
            });

            const allCategoriesMaster = document.getElementById('allCategories');
            if (allCategoriesMaster) {
                allCategoriesMaster.addEventListener('change', function () {
                    setTimeout(updateDependantFilters, 10);
                });
            }

            // Run once on page load initialization to adjust state rules if parameters are active from a reload cycle
            setTimeout(updateDependantFilters, 100);
        });
    </script>
}
