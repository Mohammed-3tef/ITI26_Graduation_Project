@model Mazeed.BLL.ViewModels.ShopCatalogVM

@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-banner {
        background: linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.35)), url('https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
        border-radius: 16px;
        padding: 40px 20px;
        color: #ffffff;
        margin-bottom: 30px;
    }

    @@media (min-width: 768px) {
        .hero-banner {
            border-radius: 20px;
            padding: 90px 60px;
            margin-bottom: 40px;
        }
    }

    .badge-pill-red {
        background-color: #ff4d4f;
        color: white;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 4px;
        display: inline-block;
    }

    .badge-sale {
        position: absolute;
        top: 12px;
        left: 12px;
        background-color: #ff4d4f;
        color: white;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        z-index: 2;
    }

    .filter-scroll-container {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        white-space: nowrap;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

        .filter-scroll-container::-webkit-scrollbar {
            display: none;
        }

    .btn-filter {
        border-radius: 50px;
        padding: 6px 18px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        color: #4b5563;
        text-decoration: none;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

        .btn-filter.active, .btn-filter:hover {
            background-color: #111827;
            color: #ffffff;
            border-color: #111827;
        }

    .product-card {
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        overflow: hidden;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
        }

    .product-img-wrapper {
        position: relative;
        background-color: #f4f4f5;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    @@media (min-width: 576px) {
        .product-img-wrapper {
            height: 240px;
        }
    }

    .product-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }

    .category-tag {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #9ca3af;
        text-transform: uppercase;
    }

    .rating {
        font-size: 11px;
        font-weight: 700;
        color: #111827;
    }

    .product-title {
        font-size: 15px;
        font-weight: 700;
        color: #111827;
        margin-top: 4px;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .current-price {
        font-size: 16px;
        font-weight: 700;
        color: #ff4d4f;
    }

        .current-price.dark {
            color: #111827;
        }

    .original-price {
        font-size: 12px;
        color: #9ca3af;
        text-decoration: line-through;
        margin-left: 4px;
    }

    /* تكبير وتصميم زر الـ Wishlist */
    .wishlist-btn {
        background: none;
        border: none;
        color: #9ca3af;
        font-size: 24px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .wishlist-btn:hover {
            transform: scale(1.15);
        }

        .wishlist-btn.active {
            color: #ff4d4f;
        }

    .btn-action-dark {
        background-color: #111827;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 8px 0;
        font-size: 12px;
        font-weight: 600;
        width: 100%;
        text-align: center;
        text-decoration: none;
        display: block;
    }

        .btn-action-dark:hover {
            background-color: #1f2937;
            color: #ffffff;
        }

    .btn-action-light {
        background-color: #ffffff;
        color: #374151;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 8px 0;
        font-size: 12px;
        font-weight: 600;
        width: 100%;
        text-align: center;
        text-decoration: none;
        display: block;
    }

        .btn-action-light:hover {
            background-color: #f9fafb;
            color: #374151;
        }

    /* تنسيق أزرار التنقل Pagination */
    .pagination-dots-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 40px;
        margin-bottom: 20px;
    }

    .page-dot-btn {
        background: none;
        border: none;
        color: #d1d5db;
        font-size: 24px;
        cursor: pointer;
        padding: 0 4px;
        transition: color 0.2s ease;
    }

        .page-dot-btn:hover {
            color: #9ca3af;
        }

        .page-dot-btn.active {
            color: #111827;
        }

    /* أزرار الأسهم: مربع داكن #111827 وسهم أبيض */
    .page-nav-btn {
        background-color: #111827;
        border: none;
        color: #ffffff;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

        .page-nav-btn:hover:not(:disabled) {
            background-color: #1f2937;
            transform: translateY(-1px);
        }

        .page-nav-btn:disabled {
            background-color: #e5e7eb;
            color: #9ca3af;
            cursor: not-allowed;
            transform: none;
        }
</style>

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="hero-banner">
        <div class="col-12 col-md-10 col-lg-6">
            <span class="badge-pill-red mb-2 mb-md-3">Limited Time Drop</span>
            <h1 class="display-5 display-md-4 fw-bold text-white mb-2 mb-md-3">Seasonal Renewal</h1>
            <p class="text-white-50 mb-4 fs-6 leading-relaxed">
                Discover curated designs from international makers. Transform your routine with bespoke objects crafted for modern life.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <a asp-controller="Store" asp-action="Index" class="btn btn-light rounded-2 px-4 py-2 fw-semibold fs-7">Shop The Sale</a>
                <a asp-controller="Home" asp-action="About" class="text-white text-decoration-none fw-semibold fs-7">Learn More &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Section Header & Dynamic Category Filters -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end gap-3 mb-4">
        <div>
            <span class="badge-pill-red mb-1" style="background: none; color: #ff4d4f; padding: 0; font-size: 10px;">CURATED FINDS</span>
            <h2 class="fw-bold fs-3 text-dark mb-0">Featured Marketplace</h2>
        </div>
        <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-md-end">
            <div class="filter-scroll-container">
                <a asp-controller="Home" asp-action="Index" class="btn-filter @(Model?.CategoryId == null ? "active" : "")">All</a>
                @if (Model?.Categories != null && Model.Categories.Any())
                {
                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="btn-filter @(Model.CategoryId == cat.Id ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                }
            </div>

            <!-- زر الفلتر بنفس ستايل باقي الزراير البيضاوية -->
            <button class="btn-filter border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas" style="cursor: pointer;">
                Filter <i class="fa-solid fa-sliders ms-1"></i>
            </button>
        </div>
    </div>

    <!-- Dynamic Product Grid -->
    <div class="row g-3 g-md-4" id="productGrid">
        @if (Model?.Items != null && Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-sm-6 col-lg-4 product-item" id="product-card-@item.Id">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                            {
                                <span class="badge-sale">SALE</span>
                            }

                            @if (item.Photos != null && item.Photos.Any())
                            {
                                <img src="@item.Photos.First()" alt="@item.Name" />
                            }
                            else
                            {
                                <i class="fa-solid fa-box-open fa-3x text-muted"></i>
                            }
                        </div>
                        <div class="product-card-body">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="category-tag">
                                        @(item.CategoryNames != null && item.CategoryNames.Any()
                                            ? item.CategoryNames.First()
                                            : (item.BrandName ?? "GENERAL"))
                                    </span>
                                    <span class="rating rating-value" data-item-id="@item.Id">&#9734; —</span>
                                </div>
                                <div class="product-title" title="@item.Name">@item.Name</div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="current-price @(item.OldPrice.HasValue && item.OldPrice > item.Price ? "" : "dark")">
                                            $@item.Price.ToString("N2")
                                        </span>
                                        @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                                        {
                                            <span class="original-price">$@item.OldPrice.Value.ToString("N2")</span>
                                        }
                                    </div>
                                    <button class="wishlist-btn" type="button" title="Add to Wishlist" data-item-id="@item.Id" onclick="toggleWishlist(this)">&#9825;</button>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <a asp-controller="Home"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn-action-dark text-center d-block text-decoration-none">Details</a>
                                </div>

                                <!-- زرار Cancel يخفي الكارت بالكامل مباشرة -->
                                <div class="col-6">
                                    <button type="button"
                                            class="btn-action-light w-100"
                                            onclick="hideProductCard(@item.Id)">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                <h5 class="text-muted fw-bold">No products found</h5>
                <p class="text-muted small">Try selecting another category or check back later.</p>
            </div>
        }
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel" style="width: 380px;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold" id="filterOffcanvasLabel">Filter & Sort</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <form asp-controller="Home" asp-action="Index" method="get" class="d-flex flex-column h-100">
            <!-- Preserve existing search term -->
            <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />

            <div class="offcanvas-body">
                <div class="accordion accordion-flush" id="filterAccordion">

                    <!-- Sort By Accordion -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingSort">
                            <button class="accordion-button collapsed fw-bold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSort">
                                Sort By
                            </button>
                        </h2>
                        <div id="collapseSort" class="accordion-collapse collapse show">
                            <div class="accordion-body">
                                <select name="sortBy" class="form-select">
                                    <option value="">Default Order</option>
                                    <option value="price_low_high" selected="@(Model.SortBy == "price_low_high")">Price: Low to High</option>
                                    <option value="price_high_low" selected="@(Model.SortBy == "price_high_low")">Price: High to Low</option>
                                    <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name: A to Z</option>
                                    <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name: Z to A</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Category Filter -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingCategory">
                            <button class="accordion-button collapsed fw-bold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCategory">
                                Product Category
                            </button>
                        </h2>
                        <div id="collapseCategory" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                @if (Model.Categories != null)
                                {
                                    @foreach (var category in Model.Categories)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="categoryId" id="cat_@category.Id" value="@category.Id" @(Model.CategoryId == category.Id ? "checked" : "") />
                                            <label class="form-check-label ms-1" for="cat_@category.Id">@category.Name</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Brand Filter -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingBrand">
                            <button class="accordion-button collapsed fw-bold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBrand">
                                Brand
                            </button>
                        </h2>
                        <div id="collapseBrand" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                @if (Model.Brands != null)
                                {
                                    @foreach (var brand in Model.Brands)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="brandId" id="brand_@brand.Id" value="@brand.Id" @(Model.BrandId == brand.Id ? "checked" : "") />
                                            <label class="form-check-label ms-1" for="brand_@brand.Id">@brand.Name</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Price Range Filter -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingPrice">
                            <button class="accordion-button collapsed fw-bold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrice">
                                Price
                            </button>
                        </h2>
                        <div id="collapsePrice" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="number" name="minPrice" class="form-control" placeholder="Min" value="@Model.MinPrice" />
                                    </div>
                                    <div class="col-6">
                                        <input type="number" name="maxPrice" class="form-control" placeholder="Max" value="@Model.MaxPrice" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Offcanvas Apply Button -->
            <div class="p-3 border-top bg-white">
                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold text-uppercase">
                    Apply (@Model.TotalCount) <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Pagination Controls (Dark Square Buttons with White Arrows) -->
    @if (Model?.Items != null && Model.Items.Count() > 9)
    {
        <div class="pagination-dots-container" id="paginationContainer">
            <button class="page-nav-btn" id="prevBtn" onclick="changePage(-1)" title="Previous">&#10094;</button>
            <button class="page-dot-btn active" onclick="goToPage(0)">&bull;</button>
            <button class="page-dot-btn" onclick="goToPage(1)">&bull;</button>
            <button class="page-dot-btn" onclick="goToPage(2)">&bull;</button>
            <button class="page-nav-btn" id="nextBtn" onclick="changePage(1)" title="Next">&#10095;</button>
        </div>
    }
</div>

<script>
    const itemsPerPage = 9;
    let currentPage = 0;

    function renderPagination() {
        const items = document.querySelectorAll('.product-item');
        const totalPages = Math.ceil(items.length / itemsPerPage);

        items.forEach((item, index) => {
            if (index >= currentPage * itemsPerPage && index < (currentPage + 1) * itemsPerPage) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });

        const dots = document.querySelectorAll('.page-dot-btn');
        dots.forEach((dot, index) => {
            if (index < totalPages) {
                dot.style.display = 'inline-block';
                dot.classList.toggle('active', index === currentPage);
            } else {
                dot.style.display = 'none';
            }
        });

        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        if (prevBtn) prevBtn.disabled = currentPage === 0;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
    }

    function goToPage(pageIndex) {
        currentPage = pageIndex;
        renderPagination();
    }

    function changePage(direction) {
        currentPage += direction;
        renderPagination();
    }

    function redirectToLogin() {
        const returnUrl = window.location.pathname + window.location.search;
        if (typeof toastr !== 'undefined') toastr.info('Please sign in to continue.');
        setTimeout(function () {
            window.location.href = '/Auth/Login?ReturnUrl=' + encodeURIComponent(returnUrl);
        }, 900);
    }

    function toggleWishlist(btn) {
        const itemId = btn.dataset.itemId;
        const isActive = btn.classList.contains('active');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers = { 'Accept': 'application/json' };
        if (token) headers['RequestVerificationToken'] = token;

        fetch(`/api/wishlist/${itemId}`, { method: isActive ? 'DELETE' : 'POST', headers })
            .then(res => {
                if (res.status === 401) {
                    redirectToLogin();
                    throw new Error('unauthenticated');
                }
                if (!res.ok) throw new Error('request failed');

                btn.classList.toggle('active');
                btn.innerHTML = btn.classList.contains('active') ? '&#9829;' : '&#9825;';
                if (typeof toastr !== 'undefined') {
                    toastr.success(isActive ? 'Removed from favorites.' : 'Added to favorites.');
                }
            })
            .catch(() => { /* handled or silent */ });
    }

    function prefillWishlistState() {
        fetch('/api/wishlist', { headers: { 'Accept': 'application/json' } })
            .then(res => res.ok ? res.json() : null)
            .then(result => {
                const favoritedIds = (result?.data || []).map(i => String(i.itemId));
                document.querySelectorAll('.wishlist-btn').forEach(btn => {
                    if (favoritedIds.includes(btn.dataset.itemId)) {
                        btn.classList.add('active');
                        btn.innerHTML = '&#9829;';
                    }
                });
            })
            .catch(() => { /* not signed in */ });
    }

    function loadRealRatings() {
        const ratingEls = document.querySelectorAll('.rating-value');
        const itemIds = Array.from(ratingEls).map(el => parseInt(el.dataset.itemId, 10));
        if (!itemIds.length) return;

        fetch('/api/reviews/summaries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ ItemIds: itemIds })
        })
            .then(res => res.ok ? res.json() : null)
            .then(result => {
                const summaries = result?.data || {};
                ratingEls.forEach(el => {
                    const s = summaries[el.dataset.itemId];
                    if (s && s.reviewCount > 0) {
                        el.innerHTML = `&#9733; ${s.averageRating.toFixed(1)}`;
                    } else {
                        el.innerHTML = `&#9734; New`;
                    }
                });
            })
            .catch(() => { /* leave placeholder dashes */ });
    }

    function hideProductCard(productId) {
        // تحديد الكارت بناءً على الـ ID
        const cardElement = document.getElementById('product-card-' + productId);

        if (cardElement) {
            // تأثير اختفاء سلس (Smooth Transition)
            cardElement.style.transition = "all 0.4s ease";
            cardElement.style.opacity = "0";
            cardElement.style.transform = "scale(0.9)";

            // إزالة العنصر من الصفحة بعد انتهاء الأنيميشن
            setTimeout(() => {
                cardElement.remove();
                renderPagination(); // تحديث الصفحات بعد مسح العنصر
            }, 400);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        renderPagination();
        prefillWishlistState();
        loadRealRatings();
    });
</script>