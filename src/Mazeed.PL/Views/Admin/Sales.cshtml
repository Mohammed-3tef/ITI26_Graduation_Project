@model IEnumerable<Mazeed.BLL.ViewModels.Admin.SalesOrderVM>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sales & Orders";
    var statuses = ViewBag.Statuses as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="container-fluid py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Sales & Orders</h1>
            <p class="text-muted mb-0">Review orders, payment status, customers, and delivery details.</p>
        </div>
        <div class="text-muted small">@Model.Count() order(s)</div>
    </div>

    <form method="get" asp-action="Sales" class="card border-0 shadow-sm p-3 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Order number, customer, phone" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var item in statuses)
                    {
                        <option value="@item" selected="@(item == (string?)ViewBag.Status)">@item</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold">From</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold">To</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button class="btn btn-danger flex-grow-1" type="submit"><i class="fa-solid fa-filter me-1"></i>Filter</button>
                <a asp-action="Sales" class="btn btn-outline-secondary" title="Clear filters"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center text-muted">
            <i class="fa-solid fa-receipt fa-2x mb-3"></i>
            <p class="mb-0">No orders match the selected filters.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Order</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th class="pe-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var statusClass = order.Status.Equals("Paid", StringComparison.OrdinalIgnoreCase) || order.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase)
                                ? "bg-success text-white"
                                : order.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || order.Status.Equals("Payment failed", StringComparison.OrdinalIgnoreCase)
                                    ? "bg-danger text-white"
                                    : "bg-warning text-dark";
                            <tr>
                                <td class="ps-3 fw-semibold">#@order.Id</td>
                                <td><div class="fw-semibold">@order.CustomerName</div><small class="text-muted">@order.PhoneNumber</small></td>
                                <td>@order.OrderingDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>@order.ItemsCount</td>
                                <td class="fw-semibold">@order.TotalPrice.ToString("N2") EGP</td>
                                <td>@order.PaymentStatus</td>
                                <td><span class="badge @statusClass">@order.Status</span></td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#adminOrder-@order.Id" aria-expanded="false" title="View order details">
                                        <i class="fa-solid fa-chevron-down"></i><span class="visually-hidden">View order details</span>
                                    </button>
                                </td>
                            </tr>
                            <tr class="collapse" id="adminOrder-@order.Id">
                                <td colspan="8" class="bg-light px-3 py-3">
                                    <div class="row g-3">
                                        <div class="col-12 col-lg-4">
                                            <div class="small text-muted">Shipping address</div>
                                            <div class="fw-semibold">@order.CustomerName</div>
                                            <div>@order.PhoneNumber</div>
                                            <div>@order.ShippingAddress</div>
                                        </div>
                                        <div class="col-12 col-lg-8">
                                            <div class="small text-muted mb-1">Order items</div>
                                            <div class="table-responsive">
                                                <table class="table table-sm mb-2">
                                                    <thead><tr><th>Product</th><th>Variant</th><th>Qty</th><th>Unit price</th><th class="text-end">Total</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var item in order.Items)
                                                        {
                                                            <tr><td>@item.ItemName</td><td>@item.Variant <span class="text-muted">(@item.SKU)</span></td><td>@item.Quantity</td><td>@item.PricePerItem.ToString("N2")</td><td class="text-end">@item.LineTotal.ToString("N2")</td></tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <form method="post" asp-action="UpdateOrderStatus" class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <label class="small fw-semibold" for="status-@order.Id">Update status</label>
                                        <select id="status-@order.Id" name="status" class="form-select form-select-sm" style="max-width:180px">
                                            @foreach (var item in statuses)
                                            {
                                                <option value="@item" selected="@(item == order.Status)">@item</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm btn-danger" type="submit">Save status</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>