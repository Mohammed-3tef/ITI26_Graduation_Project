<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_MetaDataPartial" />
    <title>@ViewData["Title"] - Mazeed</title>
    <script>
        (function () {
            const theme = localStorage.getItem("mazeed-theme");
            if (theme === "dark") document.documentElement.dataset.theme = "dark";
        })();
    </script>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/Mazeed.PL.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        .mazeed-split-container {
            min-height: 100vh;
            display: flex;
        }

        .mazeed-left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2.5rem 3.5rem;
            background-color: #ffffff;
        }

        .brand-logo {
            font-size: 1.75rem;
            font-weight: 800;
            color: #0f172a;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .brand-logo span {
            color: #ef4444;
        }

        /* Status Icon Badges */
        .status-icon-box {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
            background-color: #fef2f2;
            color: #ef4444;
        }

        .status-icon-box.success {
            background-color: #dcfce7;
            color: #16a34a;
        }

        .status-icon-box.danger {
            background-color: #fee2e2;
            color: #dc2626;
        }

        .icon-badge-success {
            width: 64px;
            height: 64px;
            background-color: #fef2f2;
            color: #ef4444;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            margin-bottom: 1.5rem;
            border: 1px solid #fee2e2;
        }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: #94a3b8;
            font-size: 0.85rem;
            margin: 1.25rem 0;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e2e8f0;
        }

        .divider span {
            padding: 0 0.75rem;
        }

        /* Input Controls */
        .input-icon-wrapper {
            position: relative;
        }

        .input-icon-wrapper i.input-prefix-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 1rem;
            z-index: 5;
        }

        .input-icon-wrapper .form-control,
        .input-icon-wrapper .form-select {
            padding-left: 2.75rem;
            height: 48px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            font-size: 0.95rem;
        }

        .input-icon-wrapper .form-control:focus,
        .input-icon-wrapper .form-select:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
        }

        .password-toggle-btn {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 0;
            z-index: 5;
        }

        /* Buttons & Links */
        .btn-google {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            color: #1e293b;
            font-weight: 500;
            height: 48px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            transition: background-color 0.2s;
        }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
        }

        .btn-mazeed-submit {
            background-color: #ef4444;
            border: none;
            color: #ffffff;
            font-weight: 600;
            height: 48px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: background-color 0.2s ease-in-out;
        }

        .btn-mazeed-submit:hover {
            background-color: #dc2626;
            color: #ffffff;
        }

        .btn-mazeed-outline {
            background-color: transparent;
            border: 1px solid #cbd5e1;
            color: #475569;
            font-weight: 600;
            height: 48px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s ease-in-out;
        }

        .btn-mazeed-outline:hover {
            background-color: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

        .btn-mazeed-secondary {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #475569;
            font-weight: 600;
            height: 48px;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .btn-mazeed-secondary:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

        .text-mazeed-primary {
            color: #ef4444 !important;
            text-decoration: none;
            font-weight: 500;
        }

        .text-mazeed-primary:hover {
            text-decoration: underline;
        }

        .form-check-input:checked {
            background-color: #ef4444;
            border-color: #ef4444;
        }

        /* Step Progress Bar */
        .step-progress {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            position: relative;
        }

        .step-progress::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 2px;
            background-color: #e2e8f0;
            z-index: 1;
            transform: translateY(-50%);
        }

        .step-progress-line {
            position: absolute;
            top: 50%;
            left: 0;
            height: 2px;
            background-color: #ef4444;
            z-index: 1;
            transform: translateY(-50%);
            transition: width 0.3s ease;
            width: 0%;
        }

        .step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #ffffff;
            border: 2px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.85rem;
            color: #64748b;
            z-index: 2;
            transition: all 0.3s ease;
        }

        .step-circle.active,
        .step-circle.completed {
            border-color: #ef4444;
            background-color: #ef4444;
            color: #ffffff;
        }

        .form-step {
            display: none;
        }

        .form-step.active {
            display: block;
            animation: fadeIn 0.3s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 991.98px) {
            .mazeed-split-container {
                flex-direction: column;
            }

            .mazeed-left-panel {
                padding: 2rem 1.5rem;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <button type="button" class="theme-toggle theme-toggle-floating" data-theme-toggle aria-label="Switch to dark mode" title="Switch theme">
        <i class="bi bi-moon-fill" data-theme-icon></i>
    </button>
    <partial name="_Loader" />
    <partial name="_Notification" />

    <div class="mazeed-split-container">
        <!-- Left Panel Wrapper -->
        <div class="mazeed-left-panel">
            <div>
                <a asp-controller="Home" asp-action="Index" class="brand-logo">Mazeed<span>+</span></a>
            </div>

            <!-- Dynamic View Content -->
            @RenderBody()

            <!-- Bottom Copyright -->
            <div class="text-center">
                <p class="text-muted small mb-0">&copy; 2026 Mazeed Shopping Inc. All rights reserved.</p>
            </div>
        </div>

        <!-- Shared Right Panel Partial -->
        @await Html.PartialAsync("_RightPanel")
    </div>

    <partial name="_Footer" />

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await RenderSectionAsync("Scripts", required: false);
    }
</body>
</html>