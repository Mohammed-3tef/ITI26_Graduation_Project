@model Mazeed.BLL.ViewModels.User.LoginVM

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mazeed</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        .mazeed-split-container {
            min-height: 100vh;
            display: flex;
        }

        .mazeed-left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2.5rem 3.5rem;
            background-color: #ffffff;
        }

        .brand-logo {
            font-size: 1.75rem;
            font-weight: 700;
            color: #0f172a;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .brand-logo span {
            color: #ef4444;
        }

        /* Divider with text */
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: #94a3b8;
            font-size: 0.85rem;
            margin: 1.5rem 0;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e2e8f0;
        }

        .divider span {
            padding: 0 0.75rem;
        }

        /* Input styling with icons */
        .input-icon-wrapper {
            position: relative;
        }

        .input-icon-wrapper i.input-prefix-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 1rem;
            z-index: 5;
        }

        .input-icon-wrapper .form-control {
            padding-left: 2.75rem;
            padding-right: 2.75rem;
            height: 48px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            font-size: 0.95rem;
        }

        .input-icon-wrapper .form-control:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
        }

        .password-toggle-btn {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 0;
            z-index: 5;
        }

        /* Buttons & Links */
        .btn-google {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            color: #1e293b;
            font-weight: 500;
            height: 48px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            transition: background-color 0.2s;
        }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
        }

        .btn-mazeed-submit {
            background-color: #ef4444;
            border: none;
            color: #ffffff;
            font-weight: 600;
            height: 48px;
            border-radius: 8px;
            width: 100%;
            transition: background-color 0.2s ease-in-out;
        }

        .btn-mazeed-submit:hover {
            background-color: #dc2626;
            color: #ffffff;
        }

        .text-mazeed-primary {
            color: #ef4444 !important;
            text-decoration: none;
            font-weight: 500;
        }

        .text-mazeed-primary:hover {
            text-decoration: underline;
        }

        .form-check-input:checked {
            background-color: #ef4444;
            border-color: #ef4444;
        }

        @@media (max-width: 991.98px) {
            .mazeed-split-container {
                flex-direction: column;
            }

            .mazeed-left-panel {
                padding: 2rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="mazeed-split-container">

        <!-- Left Panel Form -->
        <div class="mazeed-left-panel">

            <!-- Top Header Logo -->
            <div>
                <a asp-controller="Home" asp-action="Index" class="brand-logo">Mazeed<span>+</span></a>
            </div>

            <!-- Main Form Content Area -->
            <div class="my-auto py-4 mx-auto w-100" style="max-width: 420px;">
                <h1 class="fw-bold fs-2 text-dark mb-1">Welcome back</h1>
                <p class="text-muted small mb-4">Enter your credentials below to access your account</p>

                <!-- Google External Auth Button -->
                <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    <button type="submit" name="provider" value="Google" class="btn btn-google">
                        <svg width="18" height="18" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                        </svg>
                        Continue with Google
                    </button>
                </form>

                <!-- Divider -->
                <div class="divider">
                    <span>or sign in with email</span>
                </div>

                <!-- Credentials Login Form -->
                <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Email Field -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-dark">Email Address</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-envelope input-prefix-icon"></i>
                            <input asp-for="Email" class="form-control" placeholder="you@domain.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-dark">Password</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock input-prefix-icon"></i>
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="password-toggle-btn" id="togglePasswordBtn">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Remember Me & Forgot Password Row -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                            <label class="form-check-label small text-muted ms-1" for="rememberMeCheck">
                                Remember this device
                            </label>
                        </div>
                        <a asp-action="ForgotPassword" class="small text-mazeed-primary">Forgot password?</a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-mazeed-submit">Sign In</button>
                </form>

                <!-- Footer Create Account Link -->
                <p class="text-center small text-muted mt-4 mb-0">
                    New to Mazeed? <a asp-action="Register" class="text-mazeed-primary">Create account</a>
                </p>
            </div>

            <!-- Bottom Copyright -->
            <div class="text-center">
                <p class="text-muted small mb-0">&copy; 2026 Mazeed Shopping Inc. All rights reserved.</p>
            </div>
        </div>

        <!-- Right Panel Partial -->
        @await Html.PartialAsync("_RightPanel")

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Password Show/Hide Toggle Script -->
    <script>
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('passwordInput');
        const togglePasswordIcon = document.getElementById('togglePasswordIcon');

        if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
            togglePasswordBtn.addEventListener('click', function () {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);

                togglePasswordIcon.classList.toggle('bi-eye');
                togglePasswordIcon.classList.toggle('bi-eye-slash');
            });
        }
    </script>
</body>
</html>