@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Confirm Your Email";
}

<div class="my-auto py-4 mx-auto w-100" style="max-width: 440px;">
    <h1 class="fw-bold fs-2 text-dark mb-2">Check your email</h1>
    <p class="text-muted small lh-base mb-4">
        @(ViewBag.Message ?? "Thank you for registering! We have sent a confirmation link to your email address. Please check your inbox to activate your account.")
    </p>
    <div class="p-3 bg-light rounded-3 border mb-4">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-info-circle text-muted fs-6 mt-1"></i>
            <p class="small text-muted mb-0">
                Didn't receive the email? Make sure to check your spam or junk folder. You must confirm your email before signing in.
            </p>
        </div>
    </div>
    <div class="d-grid gap-2">
        <a asp-action="Login" class="btn btn-mazeed-submit">
            <i class="bi bi-arrow-left me-2"></i> Back to Sign In
        </a>
    </div>
    <p class="text-center small text-muted mt-4 mb-0">
        Need additional help? <a asp-controller="Home" asp-action="Contact" class="text-mazeed-primary">Contact Support</a>
    </p>
</div>