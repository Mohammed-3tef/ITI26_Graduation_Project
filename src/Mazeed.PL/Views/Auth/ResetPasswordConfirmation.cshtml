@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password Reset Successful";
}

<div class="my-auto py-4 mx-auto w-100" style="max-width: 440px;">
    <div class="icon-badge-success">
        <i class="bi bi-check-circle-fill"></i>
    </div>
    <h1 class="fw-bold fs-2 text-dark mb-2">Password reset</h1>
    <p class="text-muted small lh-base mb-4">
        Your password has been successfully reset. You can now use your new password to sign in to your account.
    </p>
    <div class="d-grid gap-2">
        <a asp-action="Login" class="btn btn-mazeed-submit">
            Continue to Sign In <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</div>