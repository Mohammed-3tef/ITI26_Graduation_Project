@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Email Confirmation";
    bool isSuccess = ViewBag.Success != null && (bool)ViewBag.Success;
}

<div class="my-auto py-4 mx-auto w-100" style="max-width: 440px;">
    @if (isSuccess)
    {
        <div class="status-icon-box success">
            <i class="bi bi-check-circle-fill fs-3"></i>
        </div>
        <h1 class="fw-bold fs-2 text-dark mb-2">Email Confirmed!</h1>
        <p class="text-muted small lh-base mb-4">
            Your email address has been successfully verified. Your account is now fully active and ready to use.
        </p>
        <div class="p-3 bg-light rounded-3 border mb-4">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-shield-check text-success fs-6 mt-1"></i>
                <p class="small text-muted mb-0">
                    You can now log in to access your dashboard, shopping cart, and account settings.
                </p>
            </div>
        </div>
        <div class="d-grid gap-2">
            <a asp-action="Login" class="btn btn-mazeed-submit">
                Continue to Sign In <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    }
    else
    {
        <div class="status-icon-box danger">
            <i class="bi bi-exclamation-triangle-fill fs-3"></i>
        </div>
        <h1 class="fw-bold fs-2 text-dark mb-2">Confirmation Failed</h1>
        <p class="text-muted small lh-base mb-4">
            @(ViewBag.ErrorMessage ?? "The confirmation link is invalid, expired, or has already been used.")
        </p>
        <div class="p-3 bg-light rounded-3 border mb-4">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-info-circle text-muted fs-6 mt-1"></i>
                <p class="small text-muted mb-0">
                    Try signing in to request a new confirmation email, or reach out if you need assistance.
                </p>
            </div>
        </div>
        <div class="d-grid gap-2">
            <a asp-action="Login" class="btn btn-mazeed-submit">
                <i class="bi bi-arrow-left me-2"></i> Back to Sign In
            </a>
        </div>
    }

    <p class="text-center small text-muted mt-4 mb-0">
        Need additional help? <a asp-controller="Home" asp-action="Contact" class="text-mazeed-primary">Contact Support</a>
    </p>
</div>