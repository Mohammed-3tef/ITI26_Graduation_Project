@model Mazeed.BLL.ViewModels.User.ForgotPasswordVM

@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mazeed</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        .mazeed-split-container {
            min-height: 100vh;
            display: flex;
        }

        .mazeed-left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2.5rem 3.5rem;
            background-color: #ffffff;
        }

        .brand-logo-container .brand-logo {
            font-size: 1.75rem;
            font-weight: 700;
            color: #0f172a;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

       .brand-logo-container .brand-logo span {
            color: #ef4444;
        }

        /* Input Controls */
        .input-icon-wrapper {
            position: relative;
        }

        .input-icon-wrapper i.input-prefix-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 1rem;
            z-index: 5;
        }

        .input-icon-wrapper .form-control {
            padding-left: 2.75rem;
            height: 48px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            font-size: 0.95rem;
        }

        .input-icon-wrapper .form-control:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
        }

        /* Buttons */
        .btn-mazeed-submit {
            background-color: #ef4444;
            border: none;
            color: #ffffff;
            font-weight: 600;
            height: 48px;
            border-radius: 8px;
            transition: background-color 0.2s ease-in-out;
        }

        .btn-mazeed-submit:hover {
            background-color: #dc2626;
            color: #ffffff;
        }

        .btn-mazeed-outline {
            background-color: transparent;
            border: 1px solid #cbd5e1;
            color: #475569;
            font-weight: 600;
            height: 48px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s ease-in-out;
        }

        .btn-mazeed-outline:hover {
            background-color: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

        @@media (max-width: 991.98px) {
            .mazeed-split-container {
                flex-direction: column;
            }

            .mazeed-left-panel {
                padding: 2rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="mazeed-split-container">

        <!-- Left Panel Form -->
        <div class="mazeed-left-panel">

            <!-- Top Header Logo -->
            <div class="brand-logo-container">
                <a asp-controller="Home" asp-action="Index" class="brand-logo">Mazeed<span>+</span></a>
            </div>

            <!-- Main Content Area -->
            <div class="my-auto py-4 mx-auto w-100" style="max-width: 440px;">
                <h1 class="fw-bold fs-2 text-dark mb-1">Forgot password?</h1>
                <p class="text-muted small mb-4">No worries! Enter the email address associated with your account and we'll send you reset instructions.</p>

                <!-- Forgot Password Form -->
                <form id="forgotPasswordForm" asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Email Address -->
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small fw-semibold text-dark">Email address</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-envelope input-prefix-icon"></i>
                            <input asp-for="Email" class="form-control" placeholder="you@domain.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-mazeed-submit">
                            Reset Password <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                        <a asp-action="Login" class="btn btn-mazeed-outline">
                            <i class="bi bi-arrow-left me-2"></i> Back to Sign In
                        </a>
                    </div>
                </form>
            </div>

            <!-- Bottom Copyright -->
            <div class="text-center">
                <p class="text-muted small mb-0">&copy; 2026 Mazeed Shopping Inc. All rights reserved.</p>
            </div>
        </div>

        <!-- Shared Right Panel Partial -->
        @await Html.PartialAsync("_RightPanel")

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>