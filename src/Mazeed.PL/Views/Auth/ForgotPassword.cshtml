@model Mazeed.BLL.ViewModels.User.ForgotPasswordVM

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="my-auto py-4 mx-auto w-100" style="max-width: 440px;">
    <h1 class="fw-bold fs-2 text-dark mb-1">Forgot password?</h1>
    <p class="text-muted small mb-4">No worries! Enter the email address associated with your account and we'll send you reset instructions.</p>

    <form id="forgotPasswordForm" asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label small fw-semibold text-dark">Email address</label>
            <div class="input-icon-wrapper">
                <i class="bi bi-envelope input-prefix-icon"></i>
                <input asp-for="Email" class="form-control" placeholder="you@domain.com" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-mazeed-submit w-100">
                Reset Password <i class="bi bi-arrow-right ms-1"></i>
            </button>
            <a asp-action="Login" class="btn btn-mazeed-outline">
                <i class="bi bi-arrow-left me-2"></i> Back to Sign In
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}